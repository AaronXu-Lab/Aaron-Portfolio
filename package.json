{
  "name": "xuweinan-portfolio",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "npm run build:stash && astro build",
    "preview": "astro preview",
    "test:candy": "node --test tests/candy-match-core.test.mjs",
    "test:flypy": "node --test tests/flypy-core.test.mjs",
    "test:forest": "node --test tests/focus-forest-core.test.mjs",
    "test:mesh": "node --test tests/mesh-gradient-core.test.mjs",
    "test:grid": "node --test tests/grid-breakpoint-core.test.mjs",
    "import:blog": "node scripts/import-blog.mjs",
    "add:post": "node scripts/add-post.mjs",
    "new": "node scripts/new-post.mjs",
    "fix:punct": "node scripts/fix-punct.mjs",
    "dev:stash": "wrangler dev --config workers/stash/wrangler.jsonc",
    "deploy:stash": "wrangler deploy --config workers/stash/wrangler.jsonc",
    "test:stash": "node --test tests/stash.test.mjs tests/stash-markdown.test.mjs",
    "build:stash": "node scripts/build-stash.mjs",
    "dev:formyson": "npm run build && wrangler d1 migrations apply formyson --local && wrangler dev",
    "test:formyson": "node --test tests/formyson.test.mjs",
    "deploy": "npm run build && wrangler deploy",
    "migrate:formyson": "wrangler d1 migrations apply formyson --remote"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "astro": "^5.12.0",
    "markdown-it": "^15.0.2",
    "pinyin-pro": "^3.28.1"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "esbuild": "^0.28.2",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "wrangler": "^4.129.0",
    "miniflare": "5.20260903.0-alpha"
  }
}
