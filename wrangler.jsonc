{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aaron-portfolio",
  "main": "workers/portfolio/index.mjs",
  "keep_vars": true,
  "compatibility_date": "2026-09-07",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/wardrobe/*", "/api/blog/*", "/", "/blog", "/blog/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "durable_objects": {
    "bindings": [{ "name": "WARDROBE_DAILY_QUOTA", "class_name": "WardrobeDailyQuota" }],
  },
  "migrations": [
    { "tag": "wardrobe-daily-quota-v1", "new_sqlite_classes": ["WardrobeDailyQuota"] },
  ],
  "d1_databases": [
    {
      "binding": "BLOG_DB",
      "database_name": "aaron-portfolio-blog",
      "database_id": "042ec1e0-2e7a-43a9-9033-0fd02120ace0",
      "migrations_dir": "workers/blog/migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "BLOG_MEDIA", "bucket_name": "aaron-portfolio-blog-media" },
  ],
  "routes": [
    {
      "pattern": "xuweinan.com",
      "custom_domain": true,
    },
    {
      "pattern": "www.xuweinan.com",
      "custom_domain": true,
    },
  ],
  "workers_dev": true,
}
