{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aaron-portfolio",
  "main": "workers/formyson/worker.js",
  "compatibility_date": "2026-09-07",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/formyson", "/formyson/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "formyson",
      "database_id": "47c0288d-2a01-4b21-9811-413271b784b6",
      "migrations_dir": "workers/formyson/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "formyson-media",
    },
  ],
  "ratelimits": [
    {
      "name": "LOGIN_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
  ],
  "vars": {
    "ADMIN_USERNAME": "admin",
  },
  "routes": [
    {
      "pattern": "xuweinan.com",
      "custom_domain": true,
    },
    {
      "pattern": "www.xuweinan.com",
      "custom_domain": true,
    },
  ],
  "workers_dev": true,
}
