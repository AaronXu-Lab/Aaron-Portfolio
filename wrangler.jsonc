{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aaron-portfolio",
  "main": "workers/portfolio/index.mjs",
  "keep_vars": true,
  "compatibility_date": "2026-09-07",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/wardrobe/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "durable_objects": {
    "bindings": [{ "name": "WARDROBE_DAILY_QUOTA", "class_name": "WardrobeDailyQuota" }],
  },
  "migrations": [
    { "tag": "wardrobe-daily-quota-v1", "new_sqlite_classes": ["WardrobeDailyQuota"] },
  ],
  "routes": [
    {
      "pattern": "xuweinan.com",
      "custom_domain": true,
    },
    {
      "pattern": "www.xuweinan.com",
      "custom_domain": true,
    },
  ],
  "workers_dev": true,
}
