{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "public-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4399",
        "--directory",
        "public"
      ],
      "port": 4399
    },
    {
      "name": "astro-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 4321
    },
    {
      "name": "astro-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "astro",
        "preview",
        "--port",
        "4322"
      ],
      "port": 4322
    }
  ]
}
