---
import Icon from './Icon.astro';

interface Props {
  scrollspy?: boolean;
  /** 与内容区同宽（--w-wide，首页用）；默认 --w-page */
  wide?: boolean;
}
const { scrollspy = false, wide = false } = Astro.props;

/** 首页 dropdown 内的锚点项（scrollspy 高亮靠 data-nav） */
const homeMenu = [
  { href: '/#about', id: 'about', label: '关于' },
  { href: '/#experience', id: 'experience', label: '经历' },
  { href: '/#projects', id: 'projects', label: '精选案例' },
];

/** 顶栏导航：作品 / 造物 / 博客 / 联系我（Skill、组件已收进造物页，从那里进入） */
const nav = [
  { href: '/work/', id: 'work', label: '作品' },
  { href: '/products/', id: 'products', label: '造物' },
  { href: '/blog/', id: 'blog', label: '博客' },
];

const path = Astro.url.pathname;
/** 独立页面的导航高亮 */
const activeId = path.startsWith('/work')
  ? 'work'
  : path.startsWith('/blog')
    ? 'blog'
    : ['/products', '/tools', '/skills', '/design'].some((p) => path.startsWith(p))
      ? 'products'
      : null;
const isHome = path === '/';
const currentLabel = activeId
  ? nav.find((item) => item.id === activeId)?.label
  : isHome
    ? '首页'
    : '导航';
---

<header class:list={['site-header', { 'is-home': isHome }]} data-scrollspy={scrollspy ? 'true' : undefined}>
  <div class:list={['inner', 'container', { wide }]}>
    <a class="brand" href="/" aria-label="Aaron Xu 的个人网站，返回首页">
      <Icon name="house-simple-bold" size={16} class="brand-icon" />
      <span>Aaron Xu 的 个人网站</span>
    </a>
    <nav class="desktop-nav" aria-label="主导航">
      {
        nav.map((item) => (
          <a
            href={item.href}
            data-nav={item.id}
            class:list={{ active: item.id === activeId }}
          >
            {item.label}
          </a>
        ))
      }
      <a href="/#contact" data-nav="contact">联系我</a>
    </nav>
    <span class="mobile-current" data-mobile-current>{currentLabel}</span>
    <button
      id="mobile-nav-toggle"
      type="button"
      aria-label="打开导航菜单"
      aria-controls="mobile-nav"
      aria-expanded="false"
    >
      <span class="icon-menu"><Icon name="list" size={20} /></span>
      <span class="icon-close"><Icon name="x" size={20} /></span>
    </button>
  </div>
  <!-- 主题切换：放在 .inner 之外，定位到窗口右上角（胶囊的 backdrop-filter 会成为 .inner 内绝对定位的包含块，所以不能放里面） -->
  <button
    id="theme-toggle"
    class="btn btn-ghost btn-sm btn-icon btn-capsule"
    type="button"
    aria-label="切换深浅色主题"
    title="切换深浅色主题"
  >
    <span class="icon-sun"><Icon name="sun" size={16} /></span>
    <span class="icon-moon"><Icon name="moon" size={16} /></span>
  </button>
  <div id="mobile-nav" class="mobile-nav-layer" aria-hidden="true">
    <nav class="mobile-nav-menu" aria-label="移动端主导航">
      <div class="mobile-nav-primary">
        <a href="/" class:list={{ active: isHome }} data-mobile-label="首页">
          <span>首页</span><span class="mono-sm">HOME</span>
        </a>
        {
          nav.map((item) => (
            <a
              href={item.href}
              data-nav={item.id}
              data-mobile-label={item.label}
              class:list={{ active: item.id === activeId }}
            >
              <span>{item.label}</span><span class="mono-sm">{item.id.toUpperCase()}</span>
            </a>
          ))
        }
        <a href="/#contact" data-nav="contact" data-mobile-label="联系我">
          <span>联系我</span><span class="mono-sm">CONTACT</span>
        </a>
      </div>
      <div class="mobile-home-group">
        <div class="mobile-group-label mono-sm">首页章节</div>
        <div class="mobile-home-links">
          {
            homeMenu.map((item) => (
              <a href={item.href} data-nav={item.id} data-mobile-label={item.label}>
                {item.label}
              </a>
            ))
          }
        </div>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease, background-color 0.3s ease;
    user-select: none;
    -webkit-user-select: none;
  }

  .site-header.scrolled {
    background: var(--header-bg);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom-color: var(--border);
  }

  .inner {
    display: flex;
    align-items: center;
    gap: clamp(14px, 3vw, 32px);
    height: 60px;
  }

  .inner.wide {
    width: min(var(--w-wide), 100% - 2 * var(--gutter));
  }

  .brand {
    display: flex;
    align-items: center;
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  /* 房子图标：非首页始终显示；首页只在滚动后（胶囊形态）出现，展开时宽度、间距、透明度一起过渡 */
  /* 出现：先让出位置（宽度、间距 0.3s），图标稍后淡入并从缩小、略偏左的位置落定；
     消失：图标先快速淡出缩小，再收起位置，文字平滑左移，不跳 */
  .brand :global(.brand-icon) {
    flex: none;
    width: 16px;
    margin-right: 8px;
    color: inherit;
    transform-origin: left center;
    transition: width 0.3s var(--ease-out), margin-right 0.3s var(--ease-out),
      opacity 0.24s ease 0.08s, transform 0.36s var(--ease-out) 0.06s, color 0.2s ease;
  }

  .site-header.is-home:not(.scrolled) .brand :global(.brand-icon) {
    width: 0;
    margin-right: 0;
    opacity: 0;
    transform: translateX(-4px) scale(0.6);
    transition: width 0.3s var(--ease-out) 0.06s, margin-right 0.3s var(--ease-out) 0.06s,
      opacity 0.14s ease, transform 0.2s ease, color 0.2s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .brand :global(.brand-icon),
    .site-header.is-home:not(.scrolled) .brand :global(.brand-icon) {
      transform: none;
      transition: color 0.2s ease;
    }
  }

  .brand:active {
    color: var(--accent-strong);
  }

  @media (hover: hover) and (pointer: fine) {
    .brand:hover {
      color: var(--accent-strong);
    }
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    /* 胶囊按钮自带左右 padding，视觉间距已经够大，按钮之间不再额外留空 */
    gap: 0;
    margin-left: auto;
  }

  .desktop-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 14px;
    color: var(--text-2);
    /* 胶囊形：左右 padding 比圆角版（10px）大，和 .btn-capsule 同一套视觉语言 */
    padding: 7px 13px;
    border-radius: var(--radius-pill);
    transition: color 0.2s ease, background-color 0.2s ease;
    white-space: nowrap;
  }

  .desktop-nav a:active {
    color: var(--text);
    background: color-mix(in oklch, var(--text) 9%, transparent);
  }

  .desktop-nav a.active {
    color: var(--accent-strong);
    font-weight: 500;
  }

  @media (hover: hover) and (pointer: fine) {
    .desktop-nav a:hover {
      color: var(--text);
      background: color-mix(in oklch, var(--text) 6%, transparent);
    }
  }

  /* 主题切换：标准 ghost 胶囊图标按钮（.btn.btn-ghost.btn-sm.btn-icon.btn-capsule，44px 正圆），这里只管定位与颜色 */
  /* 窗口右上角：44px 按钮图标中心距顶、距右都是 30px，与 60px 顶栏的垂直中线对齐；
     胶囊形态（顶栏下移 8px、高 52px，中线在 34px）时同步移到 34px */
  #theme-toggle {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 1;
    color: var(--text-2);
    transition: top 0.3s var(--ease-out), right 0.3s var(--ease-out), background-color 0.2s ease, color 0.2s ease;
  }

  @media (min-width: 900px) and (pointer: fine) {
    .site-header.scrolled #theme-toggle {
      top: 12px;
      right: 12px;
    }
  }

  /* 导航按钮左右 padding 13px：右缘外推 13px，让「联系我」的文字（而不是按钮底）对齐内容区右缘，与左边品牌名对称。
     给右上角按钮让位：内容区右缘离窗口边缘 R = (100vw - 内容宽) / 2，不足 72px 时导航左移补足 */
  .desktop-nav {
    margin-right: calc(max(0px, calc(72px - (100vw - min(var(--w-page), 100vw - 2 * var(--gutter))) / 2)) - 13px);
  }

  .inner.wide .desktop-nav {
    margin-right: calc(max(0px, calc(72px - (100vw - min(var(--w-wide), 100vw - 2 * var(--gutter))) / 2)) - 13px);
  }

  @media (hover: hover) and (pointer: fine) {
    #theme-toggle:hover {
      color: var(--text);
    }
  }

  #theme-toggle .icon-sun,
  #theme-toggle .icon-moon {
    display: inline-flex;
  }

  .icon-moon {
    display: none !important;
  }

  :global([data-theme='dark']) .icon-moon {
    display: inline-flex !important;
  }

  :global([data-theme='dark']) .icon-sun {
    display: none !important;
  }

  .mobile-current,
  #mobile-nav-toggle,
  .mobile-nav-layer {
    display: none;
  }

  .site-header a,
  .site-header button {
    touch-action: manipulation;
    -webkit-user-drag: none;
  }

  /* 滚动后顶栏收成胶囊（宽度 ≥900px 的精确指针才启用：更窄时品牌、导航、主题按钮已塞满，再内收 40px 会把按钮挤出胶囊；手机和触屏平板仍是整条顶栏）：
     胶囊的左右边缘与内容区对齐（宽度仍是 .inner 的内容宽），内容向内收 20px；
     胶囊整体下移 8px，顶部留出一点空隙；总高度仍是 60px，所以滚动时页面不会跳。
     用 inset 阴影当描边，避免描边占位让内容在胶囊出现时偏移 1px。 */
  @media (min-width: 900px) and (pointer: fine) {
    .inner {
      border-radius: 999px;
      box-shadow: inset 0 0 0 1px transparent;
      transition: height 0.3s var(--ease-out), margin-top 0.3s var(--ease-out), padding 0.3s var(--ease-out),
        background-color 0.3s ease, box-shadow 0.3s ease;
    }

    .site-header.scrolled {
      background: transparent;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      border-bottom-color: transparent;
    }

    .site-header.scrolled .inner {
      height: 52px;
      margin-top: 8px;
      box-sizing: content-box;
      /* 左右对称各外扩 20px：品牌名对齐内容区左缘，导航右端对齐内容区右缘 */
      padding-inline: 20px;
      background: var(--header-bg);
      -webkit-backdrop-filter: blur(14px);
      backdrop-filter: blur(14px);
      box-shadow: inset 0 0 0 1px var(--border), var(--shadow-card);
    }

    /* 胶囊右缘在内容区外 20px，主题按钮（右 12px、宽 44px）再留 8px 间距：内容区右缘离窗口需 ≥ 84px，再加余量（100vw 含滚动条宽度） */
    .site-header.scrolled .desktop-nav {
      margin-right: calc(max(0px, calc(88px - (100vw - min(var(--w-page), 100vw - 2 * var(--gutter))) / 2)) - 13px);
    }

    .site-header.scrolled .inner.wide .desktop-nav {
      margin-right: calc(max(0px, calc(88px - (100vw - min(var(--w-wide), 100vw - 2 * var(--gutter))) / 2)) - 13px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .inner {
      transition: none !important;
    }
  }

  @media (max-width: 720px), (hover: none) and (pointer: coarse) {
    .site-header,
    .site-header.scrolled,
    .site-header.menu-open {
      background: var(--header-bg);
      -webkit-backdrop-filter: blur(14px);
      backdrop-filter: blur(14px);
      border-bottom-color: var(--border);
    }

    .inner {
      gap: 8px;
    }

    .desktop-nav {
      display: none;
    }

    /* 移动端：主题按钮贴在菜单按钮左侧，垂直居中于 60px 顶栏 */
    #theme-toggle {
      top: 8px;
      right: calc(var(--gutter) + 44px + 4px);
    }

    .mobile-current {
      display: block;
      min-width: 0;
      margin-left: auto;
      margin-right: 48px;
      overflow: hidden;
      color: var(--text-3);
      font-family: var(--font-mono);
      font-size: 11.5px;
      letter-spacing: 0.06em;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    #mobile-nav-toggle {
      width: 44px;
      height: 44px;
    }

    #mobile-nav-toggle {
      flex: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--border-strong);
      border-radius: var(--radius);
      background: transparent;
      color: var(--text-2);
    }

    #mobile-nav-toggle:active {
      transform: scale(0.94);
    }

    #mobile-nav-toggle .icon-menu,
    #mobile-nav-toggle .icon-close {
      display: inline-flex;
    }

    #mobile-nav-toggle .icon-close,
    #mobile-nav-toggle[aria-expanded='true'] .icon-menu {
      display: none;
    }

    #mobile-nav-toggle[aria-expanded='true'] .icon-close {
      display: inline-flex;
    }

    .mobile-nav-layer {
      position: absolute;
      inset: 60px 0 auto;
      display: block;
      height: calc(100dvh - 60px);
      visibility: hidden;
      overflow: hidden;
      background: var(--bg);
      opacity: 0;
      pointer-events: none;
      transform: translateY(-8px);
      transition: opacity 0.18s ease, transform 0.18s var(--ease-out), visibility 0.18s;
    }

    .mobile-nav-layer.open {
      visibility: visible;
      opacity: 1;
      pointer-events: auto;
      transform: none;
    }

    .mobile-nav-menu {
      width: min(var(--w-page), 100% - 2 * var(--gutter));
      height: 100%;
      margin-inline: auto;
      padding: 20px 0 max(28px, env(safe-area-inset-bottom));
      overflow-y: auto;
      overscroll-behavior: contain;
      touch-action: pan-y;
      -webkit-overflow-scrolling: touch;
    }

    .mobile-nav-primary {
      border-top: 1px solid var(--border);
    }

    .mobile-nav-primary a {
      display: flex;
      min-height: 56px;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      border-bottom: 1px solid var(--border);
      color: var(--text-2);
      font-size: 18px;
      font-weight: 600;
    }

    .mobile-nav-primary a .mono-sm {
      color: var(--text-mono);
      font-size: 10.5px;
      font-weight: 400;
      letter-spacing: 0.12em;
    }

    .mobile-nav-primary a.active,
    .mobile-nav-primary a:active {
      color: var(--accent-strong);
    }

    .mobile-home-group {
      padding-top: 26px;
    }

    .mobile-group-label {
      margin-bottom: 10px;
      color: var(--text-mono);
      font-size: 11px;
      letter-spacing: 0.08em;
    }

    .mobile-home-links {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
    }

    .mobile-home-links a {
      display: inline-flex;
      min-height: 48px;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--border-strong);
      border-radius: var(--radius);
      color: var(--text-2);
      font-size: 14px;
    }

    .mobile-home-links a.active,
    .mobile-home-links a:active {
      border-color: var(--accent-border);
      color: var(--accent-strong);
      background: var(--surface-accent);
    }

    :global(html.mobile-nav-open),
    :global(html.mobile-nav-open body) {
      overflow: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-nav-layer {
      transition: none;
      transform: none;
    }
  }
</style>
