---
/** Current Working on：正在进行的实验性项目面板（首页精选区与 /work/ 共用） */
const FIGMA_URL =
  'https://www.figma.com/design/cpxGuEaNoMIHF4IZcmbUfx/Playground?node-id=539-385';

const beforeYouEnter = [
  {
    tag: 'EXPERIMENTAL',
    title: '实验性，边做边想',
    body: '这是一次探索而非成品，结构和结论都还在变 —— 某些部分可能不完整，或留着待解决的问题。',
  },
  {
    tag: 'JARGON',
    title: '会有一些专业术语',
    body: '项目用到不少较新的工具与方法，难免出现专业名词。遇到不熟悉的概念，可放心略过，不影响理解主线。',
  },
  {
    tag: 'LIVE',
    title: '在线呈现，随时可能变动',
    body: '内容以在线地址的方式持续迭代，链接指向的版本会不断更新 —— 你看到的，是它此刻的样子。',
  },
];
---

<div class="live-panel card reveal">
  <div class="badges">
    <span class="badge badge-solid">EXPERIMENTAL</span>
    <span class="badge">WORK IN PROGRESS</span>
    <span class="badge">LIVE · 持续迭代</span>
  </div>
  <h2 class="h-section">开始前安利：正在进行的<span class="accent-text">实验性项目</span></h2>
  <p class="lead">
    AI 让技术疯狂更新，传统的静态作品集很容易落后。所以我想做一个<strong
      >会生长的作品集</strong
    > —— 跟进展示我最近正在研究的事情。
  </p>
  <p class="pre-note">在点进去之前，有三件事想先说在前。</p>
  <div class="notes">
    <div class="mono-label notes-title">阅前须知 · Before You Enter</div>
    {
      beforeYouEnter.map((n) => (
        <div class="note-row">
          <span class="note-tag mono-sm">{n.tag}</span>
          <div>
            <div class="note-title">{n.title}</div>
            <p>{n.body}</p>
          </div>
        </div>
      ))
    }
  </div>
  <div class="live-cta">
    <a class="btn" href={FIGMA_URL} target="_blank" rel="noopener">
      进入项目 <span class="arrow" aria-hidden="true">→</span>
    </a>
    <span class="cta-hint mono-sm">
      <span class="dot-green" aria-hidden="true"></span>
      当前指向一个 Figma 文件 · 地址可能随版本更新
    </span>
  </div>
</div>

<style>
  .live-panel {
    padding: clamp(32px, 5.5vw, 64px);
    margin-bottom: clamp(36px, 5vw, 56px);
  }

  .badges {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 36px;
  }

  .live-panel h2 {
    margin-bottom: 20px;
    max-width: 24ch;
  }

  .live-panel > .lead {
    max-width: 58ch;
  }

  .live-panel .lead strong {
    color: var(--text);
  }

  .pre-note {
    color: var(--text-3);
    font-size: 15px;
    margin-top: 14px;
  }

  .notes {
    margin-top: 40px;
  }

  .notes-title {
    margin-bottom: 6px;
  }

  .note-row {
    display: flex;
    gap: clamp(16px, 4vw, 32px);
    padding: 20px 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .note-row:first-of-type {
    border-top: 1px solid var(--border);
  }

  .note-tag {
    color: var(--accent-strong);
    letter-spacing: 0.06em;
    flex: 0 0 clamp(96px, 14vw, 132px);
    padding-top: 3px;
  }

  .note-title {
    font-size: 16.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 5px;
  }

  .note-row p {
    font-size: 14.5px;
    color: var(--text-2);
    max-width: 66ch;
  }

  .live-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    margin-top: 40px;
  }

  .cta-hint {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--text-3);
    letter-spacing: 0.02em;
  }

  .dot-green {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--success);
  }

  @media (max-width: 560px) {
    .note-row {
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
