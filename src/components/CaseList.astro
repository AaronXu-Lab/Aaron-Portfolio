---
import Icon from './Icon.astro';
import MediaSlot from './MediaSlot.astro';
import { cases, historical } from '../data/cases';

/**
 * 案例列表：首页只渲染精选（featured: true），/work/ 渲染全部 + 历史作品集。
 * 卡片形态由 kind 决定，顺序即 cases.ts 的数组顺序。
 */
interface Props {
  all?: boolean;
}
const { all = false } = Astro.props;
const list = all ? cases : cases.filter((c) => c.featured);
---

<div class="project-grid">
  {
    list
      .filter((c) => c.kind === 'featured')
      .map((c, i) => (
        <a
          class="card project-card reveal"
          style={i > 0 ? `--d:${i * 0.1}s` : undefined}
          href={`/work/${c.slug}/`}
        >
          <MediaSlot label={c.media!.label} node={c.media!.node} ratio={c.media!.ratio} src={c.media!.src} />
          <div class="project-body">
            <div class="project-kicker">
              <span class="mono-accent">{c.num}</span>
              <span class="badge">{c.category}</span>
              {c.rating && <span class="rating mono-sm">{c.rating}</span>}
            </div>
            <h3>
              {c.title}
              {c.subEn && <span class="sub-en"> {c.subEn}</span>}
            </h3>
            <p>{c.summary}</p>
            <div class="project-tags">
              {c.tags?.map((t) => (
                <span class="chip">{t}</span>
              ))}
            </div>
            <span class="project-go mono-sm">
              阅读案例 <span class="arrow">→</span>
            </span>
          </div>
        </a>
      ))
  }
</div>

{
  list
    .filter((c) => c.kind === 'lab')
    .map((c) => (
      <a class="band long-case reveal" href={`/work/${c.slug}/`}>
        <div class="long-case-text">
          <div class="long-case-kicker">
            <span class="mono-sm lab">{c.labKicker}</span>
            <span class="mono-sm frames">{c.labFrames}</span>
          </div>
          <h3>{c.title}</h3>
          <p>{c.summary}</p>
        </div>
        <span class="long-case-go" aria-hidden="true">
          →
        </span>
      </a>
    ))
}

{all && (
  <div class="minor-row">
    {
      list
        .filter((c) => c.kind === 'minor')
        .map((c) => (
          <a class="card minor-card reveal" href={`/work/${c.slug}/`}>
            <div>
              <div class="mono-sm minor-kicker">{c.minorLabel}</div>
              <h3>{c.title}</h3>
              <p>{c.minorDesc}</p>
            </div>
            <span class="project-go mono-sm">
              查看 <span class="arrow">→</span>
            </span>
          </a>
        ))
    }
    <div class="card minor-card history reveal" style="--d:.08s">
      <div>
        <div class="mono-sm minor-kicker">Archive</div>
        <h3>历史作品集</h3>
        <div class="history-chips">
          {
            historical.map((h) => (
              <a class="chip history-link" href={h.figma} target="_blank" rel="noopener">
                <Icon name="figma-logo" size={13} />
                {h.label}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
)}

<style>
  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }

  /* 非对称双卡:主案例占更大跨度 */
  @media (min-width: 860px) {
    .project-grid {
      grid-template-columns: 1.25fr 1fr;
      align-items: stretch;
    }
  }

  .project-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .project-card :global(.media-slot) {
    border: none;
    border-bottom: 1px solid var(--border);
    border-radius: 0;
  }

  .project-body {
    padding: 28px 30px 30px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .project-kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 18px;
  }

  .project-kicker .mono-accent {
    font-size: 13px;
    letter-spacing: 0.1em;
  }

  .rating {
    color: var(--text-3);
    letter-spacing: 0.03em;
  }

  .project-body h3 {
    font-size: 25px;
    margin-bottom: 12px;
  }

  .sub-en {
    font-size: 15px;
    font-weight: 500;
    color: var(--text-3);
    letter-spacing: 0;
  }

  .project-body > p {
    color: var(--text-2);
    font-size: 15px;
    margin-bottom: 20px;
  }

  .project-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 26px;
  }

  .project-go {
    margin-top: auto;
    color: var(--accent-strong);
    letter-spacing: 0.05em;
    display: inline-flex;
    gap: 6px;
    align-items: center;
  }

  .project-go .arrow {
    transition: transform 0.25s var(--ease-out);
    display: inline-block;
  }

  @media (hover: hover) and (pointer: fine) {
    .project-card:hover .project-go .arrow,
    .minor-card:hover .project-go .arrow {
      transform: translateX(4px);
    }
  }

  /* 长案例入口（深色带） */
  .long-case {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(20px, 4vw, 48px);
    margin-top: 18px;
    padding: clamp(30px, 5vw, 52px) clamp(28px, 5vw, 56px);
    transition: transform 0.35s var(--ease-out), box-shadow 0.35s var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .long-case:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-card);
    }
  }

  .long-case:active {
    transform: translateY(-1px) scale(0.995);
  }

  .long-case-kicker {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    margin-bottom: 18px;
  }

  .long-case .lab {
    color: var(--band-accent-2);
    letter-spacing: 0.18em;
  }

  .long-case .frames {
    color: var(--band-text-3);
    letter-spacing: 0.18em;
  }

  .long-case h3 {
    font-size: clamp(22px, 3.4vw, 31px);
    margin-bottom: 12px;
    color: var(--band-text);
  }

  .long-case p {
    color: var(--band-text-2);
    font-size: 15.5px;
    max-width: 64ch;
  }

  .long-case-go {
    font-size: 30px;
    color: var(--band-accent);
    transition: transform 0.3s var(--ease-out);
    flex-shrink: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .long-case:hover .long-case-go {
      transform: translateX(6px);
    }
  }

  .minor-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 18px;
    margin-top: 18px;
  }

  .minor-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 28px 30px;
  }

  .minor-card .minor-kicker {
    color: var(--text-mono);
    margin-bottom: 12px;
  }

  .minor-card h3 {
    font-size: 20px;
    margin-bottom: 8px;
  }

  .minor-card p {
    color: var(--text-3);
    font-size: 14px;
  }

  .history-chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  .history-chips .chip {
    font-size: 12.5px;
  }

  .history-link {
    gap: 6px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .history-link svg {
    color: var(--text-3);
    transition: color 0.2s ease;
  }

  .history-link:hover {
    color: var(--accent-strong);
    border-color: var(--accent-border);
  }

  .history-link:hover svg {
    color: var(--accent-strong);
  }

  .history-link:active {
    transform: scale(0.96);
  }

</style>
