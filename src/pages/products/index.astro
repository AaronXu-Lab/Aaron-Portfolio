---
/**
 * /products/ 造物页 —— 对应 Design 画板「子页面 · 重设计 › 造物 /products」。
 * 01 产品 → 02 小工具 → 03 玩个 Go → 04 Agent Skills（三个代表 + 查看全部）→ 05 设计系统。
 * 大产品与 Skill 代表和首页 02 造物同源（src/data/showcase.ts）。
 */
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import AutoBorderImage from '../../components/AutoBorderImage.astro';
import SkillCard from '../../components/SkillCard.astro';
import SkillSheet from '../../components/SkillSheet.astro';
import { tools, games } from '../../data/products';
import { skills as agentSkills } from '../../data/skills';
import { featuredProduct, productCards, skillPicks, designSystems, type Platform } from '../../data/showcase';

const ext = { target: '_blank', rel: 'noopener' };
const platformIcon: Record<Platform, string> = {
  Web: 'globe',
  SwiftUI: 'apple-logo',
  iOS: 'apple-logo',
  Android: 'android-logo',
};
/** PWA 徽标悬停时的说明 */
const PWA_TIP = 'PWA（渐进式网页应用）：可以像 App 一样安装到手机主屏幕或电脑桌面，离线也能打开。';
const toolHref = (t: { slug: string; href?: string }) => t.href ?? `/tools/${t.slug}/`;
---

<Base
  title="造物 - Aaron Xu"
  description="Aaron Xu 工作之外独立完成的产品、小工具、小游戏、Agent Skill 与设计系统。"
>
  <div class="products-page container">
    <header class="page-head">
      <div class="mono-label reveal">Products</div>
      <h1 class="page-title reveal" style="--d:.05s">造物</h1>
      <p class="lead reveal" style="--d:.1s">
        工作之外，从设计到代码都由自己完成的东西：认真维护的产品、顺手做的小工具和小游戏、给设计师用的 Agent Skill，以及几套设计系统。
      </p>
    </header>

    <!-- ============ 01 产品 ============ -->
    <section class="block" id="sec-products" aria-labelledby="h-products">
      <div class="block-head reveal">
        <h2 id="h-products">产品</h2>
      </div>

      <a class="feature reveal" href={featuredProduct.href} {...ext}>
        <span class="feature-top">
          <span class="feature-id">
            <AutoBorderImage src={featuredProduct.icon} size={56} radius={14} />
            <span class="feature-name-wrap">
              <span class="feature-name">{featuredProduct.name}</span>
              <span class="feature-kind">{featuredProduct.kind}</span>
            </span>
          </span>
          <span class="feature-desc">{featuredProduct.desc}</span>
        </span>
        <span class="feature-numbers">
          {
            featuredProduct.numbers.map((n) => (
              <span class="number">
                <span class="number-value">{n.value}</span>
                <span class="number-label">{n.label}</span>
              </span>
            ))
          }
        </span>
      </a>

      <ul class="product-grid" role="list">
        {
          productCards.map((p, i) => (
            <li class="reveal" style={`--d:${i * 0.06}s`}>
              <a class="card-link product-card" href={p.href} {...(p.external ? ext : {})}>
                <span class="product-top">
                  <AutoBorderImage src={p.icon} size={48} radius={12} />
                  <Icon name="arrow-up-right" size={16} class="arr" />
                </span>
                <span class="product-name">{p.name}</span>
                <span class="product-desc">{p.desc}</span>
                <span class="product-kind mono-sm">{p.kind}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ============ 02 小工具 ============ -->
    <section class="block" id="sec-tools" aria-labelledby="h-tools">
      <div class="block-head reveal">
        <h2 id="h-tools">小工具</h2>
      </div>
      <ul class="tile-grid" role="list">
        {
          tools.map((t, i) => (
            <li class="reveal" style={`--d:${Math.min(i, 6) * 0.04}s`}>
              <a class="card-link tile" href={toolHref(t)} {...(t.newTab ? ext : {})}>
                <span class="tile-top">
                  <AutoBorderImage src={t.icon} alt={t.iconAlt ?? ''} size={40} />
                  {t.pwa && <span class="pwa mono-sm" data-tip={PWA_TIP}>PWA</span>}
                </span>
                <span class="tile-name">{t.name}</span>
                <span class="tile-desc">{t.description}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ============ 03 玩个 Go：与小工具同一种卡片 ============ -->
    <section class="block" id="sec-games" aria-labelledby="h-games">
      <div class="block-head reveal">
        <h2 id="h-games">玩个 Go</h2>
      </div>
      <ul class="tile-grid" role="list">
        {
          games.map((g, i) => (
            <li class="reveal" style={`--d:${i * 0.04}s`}>
              <a
                class:list={['card-link', 'tile', g.cover && `game-${g.cover.tone}`]}
                href={toolHref(g)}
                style={g.cover ? `background: ${g.cover.background}` : undefined}
                {...(g.newTab ? ext : {})}
              >
                <span class="tile-top">
                  <AutoBorderImage src={g.icon} size={40} />
                  {g.pwa && <span class="pwa mono-sm" data-tip={PWA_TIP}>PWA</span>}
                </span>
                <span class="tile-name">{g.name}</span>
                <span class="tile-desc">{g.description}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ============ 04 Agent Skills：三个代表 + 查看全部 ============ -->
    <section class="block" id="sec-skills" aria-labelledby="h-skills">
      <div class="block-head reveal">
        <h2 id="h-skills">Agent Skills</h2>
      </div>
      <ul class="tile-grid" role="list">
        {
          skillPicks.map((sk, i) => (
            <li class="reveal" style={`--d:${i * 0.05}s`}>
              <SkillCard skill={sk} sheet />
            </li>
          ))
        }
        <li class="reveal" style="--d:.15s">
          <a class="card-link tile tile-more" href="/skills/">
            <span class="more-icon" aria-hidden="true"><Icon name="squares-four" size={20} /></span>
            <span class="more-cta">查看全部 {agentSkills.length} 个 Skill<Icon name="arrow-right" size={14} /></span>
            <span class="tile-desc">越写越多，已经放不下了，所以单独收到一个页面里了。</span>
          </a>
        </li>
      </ul>
      <SkillSheet skills={skillPicks} />
    </section>

    <!-- ============ 05 设计系统 ============ -->
    <section class="block" id="sec-design" aria-labelledby="h-design">
      <div class="block-head reveal">
        <h2 id="h-design">设计系统</h2>
      </div>
      <ul class="ds-list reveal" role="list">
        {
          designSystems.map((d) => (
            <li>
              <a class="ds-row" href={d.href} {...(d.external ? ext : {})}>
                {d.icon ? (
                  <AutoBorderImage src={d.icon} size={40} radius={10} />
                ) : (
                  <span class="ds-mark" role="img" aria-label={`${d.name} 图标`}>{d.mark}</span>
                )}
                <span class="ds-id">
                  <span class="ds-name">{d.name}</span>
                  <span class="ds-platforms" aria-label="支持平台">
                    {d.platforms.map((pf) => (
                      <span class="ds-platform">
                        <Icon name={platformIcon[pf]} size={13} />
                        {pf}
                      </span>
                    ))}
                  </span>
                </span>
                <span class="ds-desc">{d.desc}</span>
                <Icon name="arrow-up-right" size={16} class="arr" />
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

<style>
  .products-page {
    padding-top: clamp(112px, 15vw, 132px);
    padding-bottom: clamp(80px, 10vw, 120px);
    display: flex;
    flex-direction: column;
    gap: clamp(56px, 8vw, 88px);
  }

  .page-head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--border);
  }

  .page-title {
    font-size: clamp(40px, 6vw, 56px);
    line-height: 1.1;
    letter-spacing: -0.035em;
    font-weight: 800;
  }

  /* 子页面简介占满内容区宽度 */
  .page-head .lead {
    color: var(--text-2);
  }

  .block {
    display: flex;
    flex-direction: column;
    gap: 28px;
    scroll-margin-top: 80px;
  }

  .block-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .block-head h2 {
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-size: 24px;
    letter-spacing: -0.015em;
    font-weight: 800;
  }

  .block-note {
    color: var(--text-3);
    font-size: 14px;
  }

  .block-note.strong {
    color: var(--text);
    font-weight: 700;
  }

  /* 共用卡片交互 */
  .card-link {
    height: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--surface);
    color: inherit;
    transition: border-color 0.2s ease, box-shadow 0.25s ease, transform 0.25s var(--ease-out);
  }

  .card-link :global(.arr) {
    color: var(--text-3);
    transition: transform 0.25s var(--ease-out), color 0.2s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .card-link:hover,
    .feature:hover {
      border-color: var(--border-strong);
      box-shadow: var(--shadow-card);
      transform: translateY(-2px);
    }

    .card-link:hover :global(.arr),
    .ds-row:hover :global(.arr) {
      transform: translate(2px, -2px);
      color: var(--accent-strong);
    }
  }

  .card-link:active,
  .feature:active {
    transform: scale(0.995);
  }

  /* ---- 01 产品 ---- */
  .feature {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: clamp(24px, 4vw, 36px) clamp(24px, 4vw, 40px);
    border: 1px solid var(--border);
    border-radius: var(--radius-panel);
    background: var(--surface);
    color: inherit;
    transition: border-color 0.2s ease, box-shadow 0.25s ease, transform 0.25s var(--ease-out);
  }

  .feature-top {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .feature-id {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .feature-name-wrap {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .feature-name {
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .feature-kind {
    color: var(--text-3);
    font-size: 13px;
  }

  .feature-desc {
    color: var(--text-2);
    font-size: 16px;
    line-height: 1.8;
  }

  /* 一条分隔线 + 三个大数字，不加框。默认（窄）在介绍下方、上方一条横线，介绍占满整行；
     区块够宽时数字移到右侧，分隔线变成左侧竖线 */
  .feature-numbers {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 64px;
    padding-top: 24px;
    border-top: 1px solid var(--border-subtle);
  }

  #sec-products {
    container-type: inline-size;
  }

  @container (min-width: 880px) {
    .feature {
      flex-direction: row;
      align-items: center;
      gap: 48px;
    }

    .feature-top {
      flex: 1;
      min-width: 0;
    }

    .feature-numbers {
      flex: none;
      flex-wrap: nowrap;
      gap: 48px;
      align-self: stretch;
      align-items: center;
      padding: 0 0 0 48px;
      border-top: 0;
      border-left: 1px solid var(--border-subtle);
    }
  }

  .number {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .number-value {
    font-size: 36px;
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .number-label {
    color: var(--text-3);
    font-size: 13px;
  }

  .product-grid,
  .tile-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }

  .product-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 20px;
  }

  .product-card {
    gap: 14px;
    padding: 24px;
  }

  .product-top,
  .tile-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .product-name {
    font-size: 18px;
    font-weight: 700;
  }

  .product-desc {
    flex: 1;
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.7;
  }

  .product-kind {
    padding-top: 12px;
    border-top: 1px solid var(--border-subtle);
    color: var(--text-mono);
  }

  /* ---- 02 / 03 / 04 共用小卡片 ---- */
  .tile-grid {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
  }

  .tile {
    gap: 12px;
    padding: 20px;
  }

  .tile-name {
    font-size: 16px;
    font-weight: 700;
  }

  .tile-desc {
    flex: 1;
    color: var(--text-2);
    font-size: 13px;
    line-height: 1.65;
  }

  .pwa {
    position: relative;
    padding: 2px 8px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--text-mono);
    font-size: 11px;
    cursor: help;
  }

  /* 悬停 PWA 徽标时的说明气泡，右对齐在徽标下方。徽标在卡片链接里面，不能再单独获得焦点，
     所以只做鼠标悬停提示，属于补充说明 */
  .pwa::after {
    content: attr(data-tip);
    position: absolute;
    top: calc(100% + 8px);
    right: -4px;
    z-index: 5;
    width: max-content;
    max-width: 220px;
    padding: 8px 10px;
    border-radius: var(--radius-lg);
    background: var(--btn-bg);
    color: var(--btn-text);
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 1.55;
    letter-spacing: 0;
    text-align: left;
    white-space: normal;
    box-shadow: var(--shadow-card);
    opacity: 0;
    transform: translateY(-4px);
    pointer-events: none;
    transition: opacity 0.18s ease, transform 0.22s var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .pwa:hover::after {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pwa::after {
      transition: opacity 0.18s ease;
      transform: none;
    }
  }

  /* 小游戏卡：底图 / 底色来自游戏本身（data 里的 cover），文字明暗随 tone 切换 */
  .game-dark {
    border-color: transparent;
    color: var(--band-text);
  }

  .game-dark .tile-desc {
    color: var(--band-text-2);
  }

  .game-dark .pwa {
    border-color: var(--band-border);
    color: var(--band-text-2);
  }

  .game-light {
    border-color: transparent;
    color: var(--text);
  }

  .game-light .tile-desc {
    color: var(--text-2);
  }

  /* 浅色游戏卡在深色主题下仍保持浅底，所以文字固定用浅色主题的深色值 */
  :global([data-theme='dark']) .game-light {
    color: oklch(0.24 0.012 264);
  }

  :global([data-theme='dark']) .game-light .tile-desc,
  :global([data-theme='dark']) .game-light .pwa {
    color: oklch(0.46 0.012 264);
    border-color: oklch(0.86 0.006 264);
  }

  /* 「查看全部」格：与另外三张同款白卡，用图标 + 蓝色标题区分（同首页「查看全部小工具」） */
  .more-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: var(--surface-accent);
    color: var(--accent-strong);
  }

  .more-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent-strong);
    font-size: 16px;
    font-weight: 700;
  }

  .more-cta :global(svg) {
    transition: transform 0.25s var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .tile-more:hover .more-cta :global(svg) {
      transform: translateX(3px);
    }
  }

  /* ---- 05 设计系统 ---- */
  .ds-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .ds-list li {
    border-bottom: 1px solid var(--border);
  }

  .ds-row {
    display: grid;
    /* 名称列按内容宽度（最窄 180px，放得下三个平台），间距收紧：图标与名称 14px，名称与描述 40px */
    grid-template-columns: 40px minmax(180px, max-content) minmax(0, 1fr) auto;
    column-gap: 14px;
    align-items: center;
    padding: 16px 8px;
    border-radius: var(--radius);
    color: inherit;
    transition: background-color 0.2s ease;
  }

  .ds-row :global(.arr) {
    color: var(--text-3);
    transition: transform 0.25s var(--ease-out), color 0.2s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .ds-row:hover {
      background: color-mix(in oklch, var(--surface) 70%, transparent);
    }
  }

  .ds-row:active {
    background: color-mix(in oklch, var(--surface) 45%, transparent);
  }

  .ds-mark {
    width: 40px;
    height: 40px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    background: var(--surface-2);
    color: var(--text-2);
    font-size: 18px;
    font-weight: 800;
  }

  .ds-id {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .ds-name {
    font-size: 17px;
    font-weight: 700;
  }

  .ds-platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
  }

  .ds-platform {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--text-mono);
    font-size: 12px;
  }

  .ds-desc {
    padding-left: 26px;
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.7;
  }

  @media (max-width: 720px) {
    .ds-row {
      grid-template-columns: 40px minmax(0, 1fr) auto;
    }

    .ds-desc {
      grid-column: 2 / 4;
      padding-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-link,
    .feature {
      transition: none;
    }
  }
</style>
