---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { formatDate, yearOf } from '../../utils';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

// 分类计数（按数量排序）
const catCount = new Map<string, number>();
for (const p of posts) {
  for (const c of p.data.categories) {
    catCount.set(c, (catCount.get(c) ?? 0) + 1);
  }
}
const categories = [...catCount.entries()].sort((a, b) => b[1] - a[1]);

// 按年分组
const byYear = new Map<string, typeof posts>();
for (const p of posts) {
  const y = yearOf(p.data.date);
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = [...byYear.entries()];
---

<Base
  title="博客 - Aaron Xu"
  description="Aaron Xu 的博客：设计、开发与 AI 的研究笔记，从 2015 到现在。"
>
  <div class="blog-page container">
    <header class="blog-head">
      <div class="mono-label reveal">Blog</div>
      <h1 class="page-title reveal" style="--d:.05s">博客</h1>
      <p class="lead reveal" style="--d:.1s">关于设计、代码和 AI 的随笔与研究笔记。</p>
    </header>

    <div class="toolbar reveal">
      <div class="filter-bar" data-filter-bar role="group" aria-label="按分类筛选">
        <div class="filters" data-blog-filters>
          <button class="chip filter on" type="button" data-cat="" aria-pressed="true">
            全部 <span class="count mono-sm">{posts.length}</span>
          </button>
          {
            categories.map(([cat, count]) => (
              <button class="chip filter" type="button" data-cat={cat} aria-pressed="false">
                {cat} <span class="count mono-sm">{count}</span>
              </button>
            ))
          }
        </div>
        <button class="chip filter" type="button" id="blog-filter-more" aria-haspopup="menu" aria-expanded="false" aria-controls="blog-filter-menu" hidden>
          更多 <span class="count mono-sm" data-overflow-count></span>
        </button>
        <div class="filter-menu" id="blog-filter-menu" role="menu" aria-labelledby="blog-filter-more" hidden></div>
      </div>
      <label class="search">
        <Icon name="magnifying-glass" size={14} />
        <span class="sr-only">搜索文章标题</span>
        <input type="search" placeholder="搜索文章标题" autocomplete="off" data-search />
      </label>
    </div>

    <div class="post-list" data-blog-list>
      {
        years.map(([year, list]) => (
          <section class="year-group" data-year={year}>
            <div class="year mono-sm" aria-hidden="true">{year}</div>
            <ol>
              {list.map((post) => (
                <li
                  class="row-wrap"
                  data-cats={post.data.categories.join('|')}
                  data-title={post.data.title.toLowerCase()}
                >
                  <a class="row" href={`/blog/${post.id}/`}>
                    <time class="mono-sm" datetime={post.data.date.toISOString()}>
                      {formatDate(post.data.date)}
                    </time>
                    <div class="row-main">
                      <span class="row-title">{post.data.title}</span>
                      <span class="row-excerpt">{post.data.excerpt}</span>
                    </div>
                    <div class="row-side">
                      {post.data.categories[0] && (
                        <span class="mono-sm row-cat">{post.data.categories[0]}</span>
                      )}
                      <span class="mono-sm row-min">{post.data.minutes} min</span>
                    </div>
                    <span class="row-arr" aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>

    <p class="empty mono-sm" hidden>没有符合条件的文章。</p>
  </div>
</Base>

<script>
  const bar = document.querySelector<HTMLElement>('[data-filter-bar]')!;
  const filters = [...bar.querySelectorAll<HTMLButtonElement>('[data-cat]')];
  const more = document.querySelector<HTMLButtonElement>('#blog-filter-more')!;
  const count = more.querySelector<HTMLElement>('[data-overflow-count]')!;
  const menu = document.querySelector<HTMLElement>('#blog-filter-menu')!;
  const rows = [...document.querySelectorAll<HTMLElement>('.row-wrap')];
  const groups = [...document.querySelectorAll<HTMLElement>('.year-group')];
  const empty = document.querySelector<HTMLElement>('.empty');

  const search = document.querySelector<HTMLInputElement>('[data-search]');
  let currentCat = '';

  // 分类与标题搜索同时生效
  const apply = () => {
    const q = (search?.value ?? '').trim().toLowerCase();
    let visible = 0;
    for (const row of rows) {
      const inCat = !currentCat || (row.dataset.cats ?? '').split('|').includes(currentCat);
      const hit = !q || (row.dataset.title ?? '').includes(q);
      const show = inCat && hit;
      row.hidden = !show;
      if (show) visible++;
    }
    for (const g of groups) {
      g.hidden = ![...g.querySelectorAll<HTMLElement>('.row-wrap')].some((r) => !r.hidden);
    }
    if (empty) empty.hidden = visible > 0;
  };

  const menuItems = filters.slice(1).map((filter) => {
    const item = filter.cloneNode(true) as HTMLButtonElement;
    item.className = 'filter-option';
    item.setAttribute('role', 'menuitemradio');
    item.removeAttribute('aria-pressed');
    item.tabIndex = -1;
    item.addEventListener('click', () => {
      select(filter);
      closeMenu(true);
    });
    menu.append(item);
    return item;
  });
  const visibleItems = () => menuItems.filter((item) => !item.hidden);

  function syncSelection() {
    for (const button of filters) {
      const selected = button.dataset.cat === currentCat;
      button.classList.toggle('on', selected);
      button.setAttribute('aria-pressed', String(selected));
    }
    for (const item of menuItems) item.setAttribute('aria-checked', String(item.dataset.cat === currentCat));
    const selectedInMenu = visibleItems().find((item) => item.dataset.cat === currentCat);
    more.classList.toggle('on', Boolean(selectedInMenu));
    const label = `更多分类，${visibleItems().length} 项`;
    more.setAttribute('aria-label', selectedInMenu ? `${label}，当前筛选：${currentCat}` : label);
    more.title = selectedInMenu ? `当前筛选：${currentCat}` : '';
  }

  function select(filter: HTMLButtonElement) {
    currentCat = filter.dataset.cat ?? '';
    syncSelection();
    apply();
  }

  function closeMenu(restoreFocus = false) {
    if (menu.hidden) return;
    menu.hidden = true;
    more.setAttribute('aria-expanded', 'false');
    if (restoreFocus) more.focus();
  }

  function positionMenu() {
    const space = bar.clientWidth - more.offsetLeft - more.offsetWidth;
    const max = bar.clientWidth - menu.offsetWidth;
    menu.style.insetInlineEnd = `${Math.max(0, Math.min(space, max))}px`;
  }

  function openMenu(last = false) {
    const items = visibleItems();
    if (!items.length) return;
    menu.hidden = false;
    more.setAttribute('aria-expanded', 'true');
    positionMenu();
    (last ? items.at(-1) : items.find((item) => item.getAttribute('aria-checked') === 'true') ?? items[0])?.focus();
  }

  function fitFilters() {
    const width = bar.clientWidth;
    if (!width) return;
    const focused = document.activeElement;
    for (const button of filters) button.hidden = false;
    const widths = filters.map((button) => parseFloat(getComputedStyle(button).width));
    const gap = parseFloat(getComputedStyle(bar).columnGap) || 0;
    const total = widths.reduce((sum, value) => sum + value, gap * (widths.length - 1));
    let visible = filters.length;

    if (total > width) {
      more.hidden = false;
      count.textContent = `+${filters.length - 1}`;
      const reserved = parseFloat(getComputedStyle(more).width) + gap;
      let used = widths[0];
      visible = 1;
      while (visible < widths.length && used + gap + widths[visible] + reserved <= width) {
        used += gap + widths[visible];
        visible++;
      }
    }

    const hidden = filters.length - visible;
    more.hidden = hidden === 0;
    count.textContent = `+${hidden}`;
    filters.forEach((button, index) => { button.hidden = index >= visible; });
    menuItems.forEach((item, index) => { item.hidden = index + 1 < visible; });
    syncSelection();
    if (hidden === 0) {
      if (menu.contains(focused) || focused === more) (filters.find((button) => button.dataset.cat === currentCat) ?? filters[0]).focus();
      closeMenu();
    } else {
      if (filters.some((button) => button === focused && button.hidden)) more.focus();
      if (!menu.hidden) {
        positionMenu();
        if (menuItems.some((item) => item === focused && item.hidden)) visibleItems()[0]?.focus();
      }
    }
  }

  for (const button of filters) button.addEventListener('click', () => select(button));
  more.addEventListener('click', () => {
    if (menu.hidden) openMenu();
    else closeMenu(true);
  });
  more.addEventListener('keydown', (event) => {
    if (!['ArrowDown', 'ArrowUp'].includes(event.key)) return;
    event.preventDefault();
    openMenu(event.key === 'ArrowUp');
  });
  menu.addEventListener('keydown', (event) => {
    if (event.key === 'Tab') {
      closeMenu(true);
      return;
    }
    if (event.key === 'Escape') {
      event.preventDefault();
      closeMenu(true);
      return;
    }
    const items = visibleItems();
    const index = items.findIndex((item) => item === document.activeElement);
    const next = {
      ArrowDown: (index + 1) % items.length,
      ArrowUp: (index - 1 + items.length) % items.length,
      Home: 0,
      End: items.length - 1,
    }[event.key];
    if (next === undefined) return;
    event.preventDefault();
    items[next]?.focus();
  });
  document.addEventListener('pointerdown', (event) => {
    if (event.target instanceof Node && !menu.contains(event.target) && !more.contains(event.target)) closeMenu();
  });
  bar.addEventListener('focusout', (event) => {
    if (event.relatedTarget && !bar.contains(event.relatedTarget as Node)) closeMenu();
  });

  bar.dataset.enhanced = '';
  fitFilters();
  new ResizeObserver(fitFilters).observe(bar);
  void document.fonts.ready.then(fitFilters);
  search?.addEventListener('input', apply);
</script>

<style>
  .blog-page {
    padding-top: clamp(112px, 15vw, 132px);
  }

  .blog-head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 40px;
  }

  .page-title {
    font-size: clamp(40px, 6vw, 56px);
    line-height: 1.1;
    letter-spacing: -0.035em;
    font-weight: 800;
  }

  /* 子页面简介占满内容区宽度 */
  .blog-head .lead {
    color: var(--text-2);
  }

  /* 分类 Chip + 标题搜索，同一行，下面一条分隔线 */
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 26px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 10px;
  }

  .filter-bar {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1 1 37rem;
    min-width: 0;
    gap: 9px;
  }

  .filter-bar:focus-within,
  .filter-bar:has(.filter-menu:not([hidden])) {
    z-index: 1;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: inherit;
    min-width: 0;
  }

  .filter-bar[data-enhanced] .filters {
    flex-wrap: nowrap;
  }

  .filter-bar .filter {
    flex: none;
    white-space: nowrap;
  }

  .filter-bar [hidden] {
    display: none;
  }

  .filter-menu {
    position: absolute;
    inset-block-start: calc(100% + 8px);
    inset-inline-end: 0;
    display: grid;
    inline-size: min(100%, 15rem);
    max-block-size: min(20rem, 45vh);
    overflow-y: auto;
    padding: 4px;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }

  .filter-option {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 12px;
    border: 0;
    border-radius: var(--radius);
    color: var(--text);
    background: var(--surface);
    font: inherit;
    font-size: 13px;
    text-align: start;
    overflow-wrap: anywhere;
    cursor: pointer;
  }

  .filter-option .count { flex: none; color: var(--text-mono); }
  .filter-option:is(:hover, :focus-visible) { background: var(--surface-2); }
  .filter-option[aria-checked='true'] { background: var(--surface-accent); color: var(--accent-strong); }
  .filter-option:active { background: var(--surface-accent); }

  .search {
    flex: 0 1 280px;
    display: flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--text-3);
    transition: border-color 0.2s ease;
  }

  .search:hover {
    border-color: var(--text-3);
  }

  .search:focus-within {
    border-color: var(--accent);
  }

  .search input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 13px;
  }

  .search input::placeholder {
    color: var(--text-3);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .search {
      flex-basis: 100%;
    }
  }

  .filter {
    background: var(--surface);
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease,
      transform 0.15s var(--ease-out);
  }

  .filter:active {
    transform: scale(0.96);
  }

  .filter:hover {
    border-color: var(--text-3);
  }

  .filter.on {
    border-color: var(--accent);
    color: var(--accent-strong);
    background: var(--surface-accent);
  }

  .filter .count {
    color: var(--text-mono);
    font-size: 10.5px;
  }

  .filter.on .count {
    color: var(--accent-strong);
  }

  .year-group {
    position: relative;
    padding-top: 26px;
  }

  .year {
    position: sticky;
    top: 72px;
    float: left;
    color: var(--text-mono);
    letter-spacing: 0.14em;
    font-size: 13px;
    width: 64px;
  }

  .year-group ol {
    list-style: none;
    margin: 0;
    padding: 0 0 0 clamp(72px, 10vw, 96px);
  }

  @media (max-width: 640px) {
    .year {
      position: static;
      float: none;
      width: auto;
      margin-bottom: 6px;
    }

    .year-group ol {
      padding-left: 0;
    }
  }

  .row {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr) auto 20px;
    gap: clamp(14px, 2.5vw, 28px);
    align-items: baseline;
    padding: 17px 6px;
    border-bottom: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    transition: background-color 0.2s ease;
  }

  .row:hover {
    background: color-mix(in oklch, var(--surface) 70%, transparent);
  }

  .row:active {
    background: color-mix(in oklch, var(--surface) 45%, transparent);
  }

  .row time {
    color: var(--text-3);
    letter-spacing: 0.04em;
  }

  .row-main {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .row-title {
    font-size: 16.5px;
    font-weight: 550;
    letter-spacing: -0.01em;
    line-height: 1.45;
    transition: color 0.2s ease;
  }

  .row:hover .row-title {
    color: var(--accent-strong);
  }

  .row-excerpt {
    font-size: 13px;
    color: var(--text-3);
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .row-side {
    display: flex;
    align-items: baseline;
    gap: 16px;
    white-space: nowrap;
  }

  .row-cat {
    color: var(--accent-strong);
  }

  .row-min {
    color: var(--text-mono);
  }

  .row-arr {
    color: var(--text-3);
    transition: transform 0.25s var(--ease-out), color 0.2s ease;
  }

  .row:hover .row-arr {
    color: var(--accent-strong);
  }

  @media (hover: hover) and (pointer: fine) {
    .row:hover .row-arr {
      transform: translateX(4px);
    }
  }

  @media (max-width: 720px) {
    .row {
      grid-template-columns: minmax(0, 1fr) 20px;
      grid-template-areas:
        'time arr'
        'main arr'
        'side arr';
    }

    .row time {
      grid-area: time;
    }

    .row-main {
      grid-area: main;
    }

    .row-side {
      grid-area: side;
    }

    .row-arr {
      grid-area: arr;
      align-self: center;
    }
  }

  .empty {
    padding: 40px 0;
    color: var(--text-3);
    letter-spacing: 0.06em;
  }
</style>
