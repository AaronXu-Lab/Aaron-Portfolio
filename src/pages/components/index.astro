---
import ComponentsLayout from '../../layouts/ComponentsLayout.astro';
import { components, groups } from '../../data/components';
---

<ComponentsLayout title="组件 - Aaron Xu" description="本站实际使用的组件，用于检查与统一调整。">
  <header class="ix-head">
    <span class="mono-label">Components</span>
    <h1 class="display">组件</h1>
    <p class="lead">
      本站实际使用的组件。每个组件页有可调属性的 Playground、结构说明与变体矩阵；
      右上角切换主题可检查深色。色板与字体规范见 <a href="/design/">/design/</a>。
    </p>
  </header>

  {groups.map((g) => (
    <section class="grp" aria-label={g}>
      <h2 class="grp-title">{g}</h2>
      <ul class="ix-grid">
        {components.filter((c) => c.group === g).map((c) => (
          <li>
            <a class="card ix-card" href={`/components/${c.slug}/`}>
              <strong>{c.name}</strong>
              <span class="mono-sm src">{c.source}</span>
              <span class="sum">{c.summary}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</ComponentsLayout>

<style>
  .ix-head { display: flex; flex-direction: column; gap: 14px; margin-bottom: 48px; max-width: 720px; }
  .grp { margin-bottom: 40px; }
  .grp-title { font-size: 20px; font-weight: 600; margin-bottom: 16px; }
  .ix-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr)); gap: 16px; }
  .ix-card { display: flex; flex-direction: column; gap: 8px; padding: 18px 20px; height: 100%; }
  .src { color: var(--text-mono); }
  .sum { font-size: 13.5px; line-height: 1.6; color: var(--text-2); }
</style>
