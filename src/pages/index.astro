        </ul>
      </div>

      <!-- Skill：只放一行（3 个代表 + 一格「查看全部」），下面是介绍文章的链接（文章目前是占位稿，写好后用 add:post --force 覆盖） -->
      <div class="lab-group">
        <h3 class="group-title reveal">Skill</h3>
        <ul class="skill-strip reveal" role="list">
          {
            skillPicks.map((sk) => (
              <li>
                <a class="skill-row" href={sk.href} {...ext}>
                  <span class="skill-symbol" aria-hidden="true"><DuotoneIcon name={sk.icon} size={22} /></span>
                  <span class="skill-text">
                    <span class="skill-name">{sk.name}</span>
                    <span class="skill-desc">{sk.description}</span>
                  </span>
                </a>
              </li>
            ))
          }
          <li class="skill-more">
            <TextLink href="/skills/">查看全部 {agentSkills.length} 个 Skill</TextLink>
            <TextLink href={SKILL_INTRO_POST}>不知道怎么用？</TextLink>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ================= 03 博客 ================= -->
  <section id="blog" class="block blog" aria-labelledby="blog-title">
    <div class="wrap block-inner">
      <div class="sec-head reveal">
        <div class="sec-titles">
          <h2 id="blog-title" class="sec-label"><span class="sec-num mono-sm">03</span>博客</h2>
          <p class="sec-statement">最近在想的事</p>
          <p class="sec-desc">一个设计师的笔记本：工作上的思考，也有工作之外的爱好。</p>
        </div>
      </div>

      <ol class="posts" data-blog-recent role="list">
        {
          posts.map((post, i) => (
            <li class="reveal" style={`--d:${i * 0.04}s`}>
              <a class="post" href={`/blog/${post.id}/`}>
                <time class="post-date mono-sm" datetime={post.data.date.toISOString()}>
                  {formatDate(post.data.date)}
                </time>
                <span class="post-main">
                  <span class="post-title">{post.data.title}</span>
                  {post.summary && <span class="post-desc">{post.summary}</span>}
                </span>
                <span class="post-meta">
                  {[post.data.categories[0], post.data.minutes && `${post.data.minutes} min`]
                    .filter(Boolean)
                    .join(' · ')}
                </span>
              </a>
            </li>
          ))
