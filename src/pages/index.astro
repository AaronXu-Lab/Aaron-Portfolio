---
/**
 * 首页（2026 改版）—— 对应 Design 画板「xuweinan.com 首屏方案」的「已确定」页：
 * 首屏 B1 卡片版 → 00 关于与经历（D-1）→ 01 精选作品 → 02 造物（大产品 / 小工具 / Skill）→ 03 博客 → 04 联系 + 页脚。
 * 顶栏暂不改（子页面还没调整），首页沿用 Header 的锚点：#about / #experience / #projects / #contact。
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import MediaSlot from '../components/MediaSlot.astro';
import Icon from '../components/Icon.astro';
import SkillIcon from '../components/SkillIcon.astro';
import HeroCaret from '../components/HeroCaret.astro';
import TextLink from '../components/TextLink.astro';
import DuotoneIcon from '../components/DuotoneIcon.astro';
import AutoBorderImage from '../components/AutoBorderImage.astro';
import ReviewWall from '../components/ReviewWall.astro';
import { mastergoReviews, REVIEWS_ARE_SAMPLE } from '../data/reviews';
import { tools, games } from '../data/products';
import { works, earlyWorks, nodeOf, featuredProduct, productCards, skillPicks } from '../data/showcase';
import { formatDate, postSummary } from '../utils';
import { skills, jobs, profile, RESUME_PDF } from '../data/about';
import { skills as agentSkills } from '../data/skills';
import { githubStars, figmaUsers, figmaLikes } from '../data/stats';

/* ---------- 03 博客：自动取最近 7 篇；简介 = 开头引用块，没写就取正文第一段（显示两行） ---------- */
const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 7)
  .map((post) => ({ ...post, summary: postSummary(post.body) }));

/* ---------- 首屏证据卡 ---------- */
const proofs = [
  {
    title: 'App Store 4.8 分',
    desc: '原生手写的 iOS 漫画应用',
    href: '/work/comic-manga/',
    img: '/media/products/comic-manga-icon.jpg',
  },
  {
    title: `${figmaUsers} · ${githubStars}`,
    desc: 'Figma 开源插件 · 把 MasterGo 图层迁移到 Figma',
    href: featuredProduct.figmaHref,
    img: '/media/products/mastergo2figma.png',
    external: true,
  },
  {
    title: 'ColorOS 极致体验奖',
    desc: 'OPPO 年度重点项目 跨屏互联（手机与电脑协同）',
    href: 'https://connect-pc.oppo.com/zh-CN/',
    img: '/media/products/coloros-icon.png',
    external: true,
  },
];

const visibleJobs = jobs.filter((j) => !j.draft);
const hasExtraJobs = visibleJobs.some((j) => !j.core);

/* ---------- 01 精选作品 / 02 造物：数据与 /work/、/products/ 共用，见 src/data/showcase.ts ---------- */
const SKILL_INTRO_POST = '/blog/how-i-write-agent-skills/';

const allTools = [...tools, ...games];
const toolPicks = [
  { slug: 'wardrobe', name: '衣集', desc: '把衣服整理成透明底图片并打标签' },
  { slug: 'prompt-lab', name: 'Prompt 擂台', desc: '同一段 Prompt 对比不同模型的实现' },
  { slug: 'stash', name: '暂存箱', desc: '免登录的临时文本与文件中转' },
  { slug: 'focus-forest', name: '专注森林', desc: '专注越久，树长得越高' },
  { slug: 'travel-maps', name: '出发吧打工人', desc: '手账风格的等时旅行地图' },
  { slug: 'mesh-gradient', name: '弥散渐变生成器', desc: '给截图加可调的渐变背景' },
  { slug: 'flying-ninja-cat', name: '飞天忍者猫', desc: '用 Canvas 重制的童年 Flash 跑酷' },
].map((t) => {
  const entry = allTools.find((x) => x.slug === t.slug);
  if (!entry) throw new Error(`products.ts 缺少 ${t.slug}`);
  return {
    ...t,
    icon: entry.icon,
    href: entry.href ?? `/tools/${entry.slug}/`,
    newTab: entry.newTab ?? false,
  };
});

const ext = { target: '_blank', rel: 'noopener' };
/** 经历徽章的颜色 → 徽章组件的颜色类 */
const badgeTone = { dark: 'badge-dark', accent: 'badge-accent' } as const;
---

<Base title="Aaron Xu - 设计工程师 · 个人作品集" scrollspy footer="simple">
  <!-- ================= 首屏 ================= -->
  <section class="hero" data-home-snap>
    <div class="wrap hero-inner">
      <p class="hero-kicker mono-sm reveal">Aaron Xu <span aria-hidden="true">/</span> 设计工程师</p>
      <h1 class="hero-title reveal" style="--d:.05s">
        Design with Code,<br />Think with <span class="accent-text">AI</span>.
      </h1>
      <div class="hero-body">
        <div class="hero-left">
          <p class="hero-intro reveal" style="--d:.12s">
            从 OPPO 的手机系统、小鹏汇天的飞行汽车座舱，再到 flomo，我一直站在设计和工程中间，让想法更快、更准确地变成产品。
          </p>
          <div class="hero-chat reveal" style="--d:.16s">
            <TextLink href="#contact">想一起做点什么？来聊聊</TextLink>
          </div>
          <ul class="proofs" role="list">
            {
              proofs.map((p, i) => (
                <li class="reveal" style={`--d:${0.2 + i * 0.06}s`}>
                  <a class="proof" href={p.href} {...(p.external ? ext : {})}>
                    {p.img ? (
                      <AutoBorderImage class="proof-icon" src={p.img} size={40} />
                    ) : (
                      <span class="proof-icon proof-icon-glyph" aria-hidden="true">
                        <Icon name={p.icon!} size={20} />
                      </span>
                    )}
                    <span class="proof-text">
                      <span class="proof-title">{p.title}</span>
                      <span class="proof-desc">{p.desc}</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <!-- 静态 webp 先出（首屏 + 减少动态效果兜底），空闲时换成 Rive 导出的可动 SVG -->
        <div class="hero-art reveal" style="--d:.18s" data-hero-art data-src="/media/home/quiet-work.json">
          <img
            src="/media/home/hero-illustration.webp"
            alt="戴圆框眼镜、穿橙色毛衣的卡通形象盘腿坐着用笔记本电脑，身旁趴着一只睡着的柴犬，右边放着一杯冒热气的咖啡"
            width="1094"
            height="620"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
    <HeroCaret />
  </section>

  <!-- 首屏之后的全部内容放进 .rest：整体算作一个吸附区，只有首屏与它之间会吸附，里面自由滚动 -->
  <div class="rest">
  <!-- ================= 00 关于与经历 ================= -->
  <section id="about" data-spy="about" class="about" aria-labelledby="about-title">
    <div class="wrap">
      <div class="about-body">
        <div class="about-top">
          <div class="about-skip reveal">
            <TextLink size="md" icon="arrow-bend-right-down" data-about-skip>不想看履历？直接看作品</TextLink>
          </div>

          <div class="about-card reveal" style="--d:.06s">
            <div class="about-head">
              <div class="about-head-row">
                <h2 id="about-title" class="sec-label"><span class="sec-num mono-sm">00</span>关于我</h2>
                <a class="btn btn-ghost btn-sm resume-btn" href={RESUME_PDF} download="Aaron Xu 简历.pdf">
                  <Icon name="download-simple" size={16} />下载简历
                </a>
              </div>
              <p class="about-hello">
                {profile.hello.before}<span class="accent-text">{profile.hello.accent}</span>{profile.hello.after}
              </p>
              <p class="about-edu">
                <Icon name="graduation-cap" size={18} />
                <span><strong>{profile.education.school}</strong> · {profile.education.detail}</span>
              </p>
            </div>
            <ul class="skills" role="list" data-skills>
              {
                skills.map((s) => (
                  <li class="skill">
                    <span class="skill-icon" aria-hidden="true">
                      <SkillIcon name={s.icon} size={22} />
                    </span>
                    <h3>{s.title}</h3>
                    <p>{s.desc}</p>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <section id="experience" data-spy="experience" class="exp" aria-labelledby="exp-title">
          <h3 id="exp-title" class="exp-title reveal">工作经历</h3>
          <ol class="jobs" data-jobs role="list">
            {
              visibleJobs.map((job) => (
                <li class:list={['job', 'reveal', { 'job-extra': !job.core, current: job.current }]}>
                  <div class="job-inner">
                    <div class="job-when">
                      <span class="job-span">{job.span}</span>
                      <span class="job-time mono-sm">{job.time}</span>
                    </div>
                    <div class="job-rail" aria-hidden="true">
                      <span class="job-dot" />
                    </div>
                    <div class="job-main">
                      <div class="job-info">
                        <span class="job-company">{job.company}</span>
                        <span class="job-role">{job.role}</span>
                        {job.badge && (
                          <span class:list={['badge', 'badge-text', 'badge-fill', 'job-badge', badgeTone[job.badge.tone]]}>{job.badge.text}</span>
                        )}
                        <span class="job-domain">{job.domain}</span>
                        {job.link && (
                          <a class="job-link" href={job.link.href} {...(job.link.external ? ext : {})}>
                            {job.link.label} {job.link.external ? '↗' : '→'}
                          </a>
                        )}
                      </div>
                      <ul class="job-points" role="list">
                        {job.points.map((p) => (
                          <li>{p}</li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </li>
              ))
            }
          </ol>
          {
            hasExtraJobs && (
              <TextLink icon="caret-down" class="jobs-toggle" data-jobs-toggle aria-expanded="false">
                <span data-jobs-label>更多经历</span>
              </TextLink>
            )
          }
        </section>
      </div>
    </div>
  </section>

  <!-- ================= 01 精选作品 ================= -->
  <section id="work" data-spy="projects" class="block work" aria-labelledby="work-title">
    <span id="projects" class="anchor-alias" aria-hidden="true"></span>
    <div class="wrap block-inner">
      <div class="sec-head reveal">
        <div class="sec-titles">
          <h2 id="work-title" class="sec-label" tabindex="-1"><span class="sec-num mono-sm">01</span>精选作品</h2>
          <p class="sec-statement">一些值得拿出来讲的项目</p>
        </div>
      </div>

      <div class="works">
        {
          works.map((w, i) => (
            <article class:list={['work-row', 'reveal', { flip: i % 2 === 1 }]}>
              <a
                class="work-cover"
                href={w.href}
                aria-label={`阅读案例：${w.title.join('')}`}
                {...(w.newTab ? ext : {})}
              >
                <MediaSlot label={w.media.label} ratio="4 / 3" src={w.media.src} />
              </a>
              <div class="work-text">
                <span class="work-kicker">{w.kicker}</span>
                <h3 class="work-title">
                  {w.title[0]}
                  <br />
                  {w.title[1]}
                </h3>
                <p class="work-desc">{w.desc}</p>
                <ul class="tags" role="list">
                  {w.tags.map((t) => (
                    <li class="tag">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>

      <div class="early reveal">
        <span class="early-label">更早的作品</span>
        <ul class="early-list" role="list">
          {
            earlyWorks.map((e, i) => (
              <li class="early-item">
                <TextLink href={e.href} icon="none" {...ext} aria-describedby={`early-${i}`}>{e.name}</TextLink>
                <span class="early-pop" role="tooltip" id={`early-${i}`}>
                  <MediaSlot class="early-pop-media" label={`${e.name} 配图`} node={nodeOf(e.href)} ratio="16 / 9" src={e.img} />
                  <span class="early-pop-desc">{e.desc}</span>
                </span>
              </li>
            ))
          }
        </ul>
        <TextLink href="/work/">查看所有作品</TextLink>
      </div>
    </div>
  </section>

  <!-- ================= 02 造物 ================= -->
  <section id="lab" class="block lab" aria-labelledby="lab-title">
    <div class="wrap block-inner">
      <div class="sec-head reveal">
        <div class="sec-titles">
          <h2 id="lab-title" class="sec-label"><span class="sec-num mono-sm">02</span>造物</h2>
          <p class="sec-statement">工作之外做的东西</p>
          <p class="sec-desc">设计和代码都自己动手，产品、工具、游戏等等都有。</p>
        </div>
        <a class="more-link" href="/products/">全部造物<Icon name="arrow-right" size={14} /></a>
      </div>

      <div class="lab-group">
        <h3 class="group-title reveal">大产品</h3>
        <div class="feature reveal">
          <a class="feature-main" href={featuredProduct.figmaHref} {...ext}>
            <span class="feature-meta">
              <AutoBorderImage src={featuredProduct.icon} size={44} />
              <span>{featuredProduct.meta}</span>
            </span>
            <span class="feature-name">{featuredProduct.name}</span>
            <span class="feature-desc">{featuredProduct.desc}</span>
            <span class="feature-stat">
              {featuredProduct.stats.map((line) => (
                <span>{line}</span>
              ))}
            </span>
          </a>
          <!-- 评论墙：数据在 src/data/reviews.ts；目前是示例数据，会显示「示例数据」标签，上线前换成真实评论 -->
          <ReviewWall reviews={mastergoReviews} sample={REVIEWS_ARE_SAMPLE} />
        </div>
        <ul class="product-cards" role="list">
          {
            productCards.map((p, i) => (
              <li class="reveal" style={`--d:${i * 0.06}s`}>
                <a class="product-card" href={p.href} {...(p.external ? ext : {})}>
                  <span class="product-head">
                    <AutoBorderImage src={p.icon} size={40} />
                    <span class="product-name">{p.name}</span>
                  </span>
                  <span class="product-desc">{p.desc}</span>
                  <span class="product-kind">{p.kind}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lab-group">
        <h3 class="group-title reveal">小工具 <span>和游戏</span></h3>
        <ul class="tool-list reveal" role="list">
          {
            toolPicks.map((t) => (
              <li>
                <a class="tool-row" href={t.href} {...(t.newTab ? ext : {})}>
                  <AutoBorderImage class="tool-icon" src={t.icon} size={43} radius={10} />
                  <span class="tool-text">
                    <span class="tool-name">{t.name}</span>
                    <span class="tool-desc">{t.desc}</span>
                  </span>
                </a>
              </li>
            ))
          }
          <li>
            <a class="tool-row tool-all" href="/products/#sec-tools">
              <span class="tool-icon tool-icon-glyph" aria-hidden="true"><Icon name="squares-four" size={22} /></span>
              <span class="tool-name">查看全部小工具</span>
            </a>
