    .skills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .skills {
      grid-template-columns: 1fr;
    }
  }

  /* 工作经历：竖轴 + 每段双栏（左信息，右要点） */
  .exp {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .exp-title {
    font-size: 28px;
    letter-spacing: -0.015em;
    font-weight: 800;
  }

  .jobs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  /* 有 JS 时默认只显示核心经历；展开/收起用 grid 行高 0fr ⇄ 1fr 做高度过渡，
     收起后再切 visibility，避免折叠内容仍可被 Tab 聚焦 */
  :global(.js) .job-extra {
    grid-template-rows: 0fr;
    visibility: hidden;
    transition: grid-template-rows 0.45s var(--ease-out), visibility 0s linear 0.45s;
  }

  :global(.js) .jobs.show-all .job-extra {
    grid-template-rows: 1fr;
    visibility: visible;
    transition: grid-template-rows 0.45s var(--ease-out), visibility 0s;
  }

  :global(.js) .job-extra .job-inner {
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  :global(.js) .jobs.show-all .job-extra .job-inner {
    opacity: 1;
    transition: opacity 0.35s ease 0.1s;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .job-extra,
    :global(.js) .job-extra .job-inner {
      transition: none !important;
    }
  }

  :global(html:not(.js)) :global(.jobs-toggle) {
    display: none;
  }

  .job {
    display: grid;
    grid-template-rows: 1fr;
  }

  .job-inner {
    display: grid;
    grid-template-columns: 150px 28px minmax(0, 1fr);
    min-height: 0;
    overflow: hidden;
  }

  .job-when {
    padding: 6px 24px 0 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
    text-align: right;
  }

  .job-span {
    font-size: 20px;
    line-height: 1.3;
    font-weight: 800;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .job.current .job-span {
    color: var(--accent);
  }

  .job-time {
    color: var(--text-2);
    white-space: nowrap;
  }

  .job-rail {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .job-rail::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--border);
  }

  .job:first-child .job-rail::before {
    top: 12px;
  }

  /* 时间轴收在最后一条分隔线处（.job-main 底边，下面还有 40px margin）：
     收起时是最后一条核心经历，展开后（或无 JS）是最后一条经历 */
  .job:last-child .job-rail::before {
    bottom: 40px;
  }

  /* 单独一条规则：:has 不被支持时只丢这一条，不连累上面的 */
  :global(.js) .jobs:not(.show-all) .job:not(.job-extra):not(:has(~ .job:not(.job-extra))) .job-rail::before {
    bottom: 40px;
  }

  .job-dot {
    position: relative;
    margin-top: 12px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--text-3);
    box-shadow: 0 0 0 5px var(--bg);
    transition: background-color 0.2s ease;
  }

  .job.current .job-dot,
  .job:hover .job-dot {
    background: var(--accent);
  }

  .job-main {
    margin-left: 28px;
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: 40px;
    padding-bottom: 40px;
    margin-bottom: 40px;
    border-bottom: 1px solid var(--border);
  }

  .job-info {
    display: flex;
    flex-direction: column;
    gap: 10px;
    line-height: 1.5;
  }

  .job-company {
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .job-role {
    font-size: 15px;
    color: var(--text-body);
  }

  /* 样式来自全局徽章组件（.badge.badge-text.badge-fill + 颜色），这里只管位置 */
  .job-badge {
    align-self: flex-start;
  }

  .job-domain {
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-2);
  }

  .job-link {
    align-self: flex-start;
    margin-top: 4px;
    font-size: 14px;
    font-weight: 600;
    color: var(--accent-strong);
    text-underline-offset: 4px;
  }

  .job-link:hover {
    text-decoration: underline;
  }

  .job-link:active {
    opacity: 0.7;
  }

  .job-points {
    list-style: none;
    margin: 0;
    padding: 6px 0 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .job-points li {
    position: relative;
    padding-left: 24px;
    font-size: 16px;
    line-height: 1.75;
    color: var(--text-body);
  }

  .job-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.86em;
    width: 12px;
    height: 2px;
    border-radius: 1px;
    background: var(--accent);
  }

  /* 位置由这里管，样式由 TextLink 管 */
  :global(.jobs-toggle) {
    margin-left: 206px;
    /* 文字离分隔线的距离 = 分隔线上方的留白（约 40px）：抵掉最后一条经历的 40px margin，
       再扣掉 TextLink 点击区在文字上方多出的约 13px */
    margin-top: -40px;
    align-self: flex-start;
  }

  @media (max-width: 1000px) {
    .job-main {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }

  @media (max-width: 640px) {
    .job-inner {
      grid-template-columns: 20px minmax(0, 1fr);
    }

    .job-when {
      grid-column: 2;
      grid-row: 1;
      flex-direction: row;
      align-items: baseline;
      gap: 12px;
      padding: 0 0 8px 16px;
      text-align: left;
    }

    .job-rail {
      grid-column: 1;
      grid-row: 1 / span 2;
    }

    .job-dot {
      margin-top: 10px;
    }

    .job-main {
      grid-column: 2;
      margin-left: 16px;
      padding-bottom: 32px;
      margin-bottom: 32px;
    }

    :global(.jobs-toggle) {
      margin-left: 36px;
    }
  }

  /* ---------- 01 精选作品 ---------- */
  .works {
    display: flex;
    flex-direction: column;
    gap: clamp(48px, 6vw, 64px);
  }

  .work-row {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(32px, 4.5vw, 56px);
    align-items: center;
  }

  .work-row.flip {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
  }

  .work-row.flip .work-cover {
    order: 2;
  }

  .work-cover {
    display: block;
    border-radius: var(--radius-media);
    overflow: hidden;
    border: 1px solid var(--border);
    transition: border-color 0.2s ease, transform 0.35s var(--ease-out), box-shadow 0.35s var(--ease-out);
  }

  .work-cover :global(.media-slot) {
    border: 0;
    border-radius: 0;
  }

  .work-cover :global(img) {
    transition: transform 0.6s var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .work-cover:hover {
      border-color: var(--border-strong);
      box-shadow: var(--shadow-card);
    }

    .work-cover:hover :global(img) {
      transform: scale(1.02);
    }
  }

  .work-cover:active {
    transform: scale(0.995);
  }

  .work-text {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .work-kicker {
    font-size: 13px;
    color: var(--text-2);
  }

  .work-title {
    font-size: clamp(24px, 2.5vw, 32px);
    line-height: 1.25;
    letter-spacing: -0.02em;
    font-weight: 800;
  }

  .work-desc {
    font-size: 16px;
    line-height: 1.75;
    color: var(--text-body);
  }

  @media (max-width: 860px) {
    .work-row,
    .work-row.flip {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .work-row.flip .work-cover {
      order: 0;
    }

    .work-title br {
      display: none;
    }
  }

  .early {
    display: flex;
    align-items: center;
    gap: 8px 20px;
    flex-wrap: wrap;
    font-size: 14px;
  }

  .early-label {
    color: var(--text-2);
  }

  .early-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0 20px;
    flex-wrap: wrap;
  }

  .early-item {
    position: relative;
    display: inline-flex;
  }

  .early-pop {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 4px);
    z-index: 3;
    width: 280px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 10px 10px 12px;
    border-radius: var(--radius-card);
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-card);
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-body);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 4px);
    transform-origin: bottom center;
    transition: opacity 0.18s var(--ease-out), transform 0.18s var(--ease-out), visibility 0.18s;
    pointer-events: none;
  }

  .early-pop :global(.early-pop-media) {
    border-radius: var(--radius);
    overflow: hidden;
  }

  .early-pop-desc {
    padding: 0 4px;
  }

  .early-item:hover .early-pop,
  .early-item:focus-within .early-pop {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%);
  }

  @media (prefers-reduced-motion: reduce) {
    .early-pop {
      transform: translateX(-50%);
    }
  }

  @media (hover: none) {
    .early-pop {
      display: none;
    }
  }

  /* ---------- 02 造物 ---------- */
  .lab-group {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .group-title {
    font-size: 16px;
    letter-spacing: 0;
    font-weight: 700;
  }

  .group-title span {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-2);
  }

  .feature,
  .product-card {
    border-radius: var(--radius-card);
    background: var(--surface);
    border: 1px solid var(--border);
    transition: border-color 0.2s ease, transform 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .product-card:hover {
      border-color: var(--border-strong);
      transform: translateY(-2px);
      box-shadow: var(--shadow-card);
    }

    .feature:hover {
      border-color: var(--border-strong);
    }
  }

  .product-card:active {
    transform: scale(0.995);
  }

  /* 主推产品：左边是产品介绍（整块是链接），右边是评论墙（每张评论各自是来源链接，所以外层不是链接） */
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    overflow: hidden;
  }

  .feature-main {
    padding: clamp(28px, 3.5vw, 40px) clamp(24px, 3.5vw, 44px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
  }

  @media (hover: hover) and (pointer: fine) {
    .feature-main:hover .feature-name {
      color: var(--accent-strong);
    }
  }

  .feature-main:active .feature-name {
    color: var(--accent-strong);
  }

  .feature :global(.rw) {
    border-left: 1px solid var(--border-subtle);
  }

  .feature-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
    color: var(--text-2);
  }


  .feature-name {
    font-size: 28px;
    line-height: 1.25;
    font-weight: 800;
    letter-spacing: -0.02em;
    transition: color 0.2s ease;
  }

  .feature-desc {
    font-size: 16px;
    line-height: 1.75;
    color: var(--text-body);
  }

  /* 与上面的描述同一种正文颜色、不加粗，字号小一号（14px） */
  .feature-stat {
    display: flex;
    flex-direction: column;
    margin-top: 4px;
    padding-top: 16px;
    border-top: 1px solid var(--border-subtle);
    font-size: 14px;
    line-height: 1.75;
    color: var(--text-body);
  }

  .product-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .product-cards li {
    display: flex;
  }

  .product-card {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
  }

  .product-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .product-head :global(img) {
    flex-shrink: 0;
    object-fit: cover;
  }

  .product-name {
    font-size: 17px;
    font-weight: 700;
  }

  .product-desc {
    flex: 1;
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-body);
  }

  .product-kind {
    font-size: 12px;
    color: var(--text-2);
  }

  .tool-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: 32px;
    border-top: 1px solid var(--border);
  }

  .tool-list li {
    border-bottom: 1px solid var(--border-subtle);
  }

  /* 图标边长 = 名称 + 简介两行文字的总高（15px×1.45 + 2px + 13px×1.45 ≈ 43px）；改字号或行高时同步改这里和 AutoBorderImage 的 size */
  .tool-row {
    --tool-icon: 43px;
    display: grid;
    grid-template-columns: var(--tool-icon) minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    min-height: 80px;
    padding: 18px 0;
    transition: color 0.2s ease;
  }

  :global(.tool-icon) {
    object-fit: cover;
  }

  .tool-icon-glyph {
    width: var(--tool-icon);
    height: var(--tool-icon);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-2);
  }

  .tool-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    line-height: 1.45;
  }

  .tool-name {
    font-size: 15px;
    font-weight: 600;
  }

  .tool-desc {
    font-size: 13px;
    color: var(--text-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tool-all .tool-name {
    font-weight: 500;
    color: var(--text-body);
  }

  @media (hover: hover) and (pointer: fine) {
    .tool-row:hover .tool-name {
      color: var(--accent-strong);
    }
  }

  /* ---------- 02 造物 · Skill ---------- */
  .skill-strip {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: 48px;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border-subtle);
  }

  /* 左侧 Symbol 与上方小工具的图标同尺寸（43px、10px 圆角），右侧名称 + 两行描述 */
  .skill-row {
    display: grid;
    grid-template-columns: 43px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
    min-height: 96px;
    padding: 20px 0;
    transition: color 0.2s ease;
  }

  .skill-symbol {
    width: 43px;
    height: 43px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface-accent);
    color: var(--accent-strong);
    transition: background-color 0.2s ease;
  }

  .skill-symbol :global(svg) {
    transition: transform 0.35s var(--ease-out);
  }

  .skill-text {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .skill-name {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.45;
  }

  .skill-desc {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    font-size: 13px;
    line-height: 1.55;
    color: var(--text-2);
  }

  @media (hover: hover) and (pointer: fine) {
    .skill-row:hover .skill-name {
      color: var(--accent-strong);
    }

    .skill-row:hover .skill-symbol :global(svg) {
      transform: scale(1.1) rotate(-4deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-symbol :global(svg) {
      transition: none;
    }
  }

  .skill-row:active .skill-name {
    color: var(--accent-strong);
  }

  /* 最后一格：两个同级的文字链接 —— 全部 Skill 页、使用介绍文章；左侧用一条短竖线与前面的 Skill 区分（不拉通整行，线落在列间距 48px 的正中、垂直居中，左右各留 24px） */
  .skill-more {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    min-height: 96px;
  }

  .skill-more::before {
    content: '';
    position: absolute;
    left: -24px;
    top: 50%;
    width: 1px;
    height: 56px;
    transform: translateY(-50%);
    background: var(--border);
  }

  /* 03 博客：「全部文章」放在列表最下方，与文章标题左对齐（日期列 140px + 间距 40px；窄屏标题顶格，不缩进） */
  :global(.blog-all) {
    align-self: flex-start;
    margin-left: 180px;
  }

  @media (max-width: 1000px) {
    .product-cards {
      grid-template-columns: 1fr;
    }

    .tool-list,
    .skill-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .feature {
      grid-template-columns: 1fr;
    }

    .feature :global(.rw) {
      --rw-h: 380px;
      border-left: 0;
      border-top: 1px solid var(--border-subtle);
    }
  }

  @media (max-width: 560px) {
    .tool-list,
    .skill-strip {
      grid-template-columns: 1fr;
    }

    .skill-more::before {
      display: none;
    }
  }

  /* ---------- 03 博客 ---------- */
  .blog .block-inner {
    gap: 40px;
  }

  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--text);
  }

  .posts li {
    border-bottom: 1px solid var(--border);
  }

  .post {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr) 150px;
    gap: 40px;
    align-items: baseline;
    padding: 26px 0;
    transition: background-color 0.2s ease;
  }

  .post-date {
    color: var(--text-2);
  }

  .post-main {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .post-title {
    font-size: 20px;
    line-height: 1.4;
    font-weight: 700;
    letter-spacing: -0.01em;
    transition: color 0.2s ease;
  }

  .post-desc {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-body);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-meta {
    justify-self: end;
    font-size: 13px;
    color: var(--text-2);
    white-space: nowrap;
  }

  @media (hover: hover) and (pointer: fine) {
    .post:hover .post-title {
      color: var(--accent-strong);
    }
  }

  .post:active {
    background: color-mix(in oklch, var(--text) 4%, transparent);
  }

  @media (max-width: 760px) {
    :global(.blog-all) {
      margin-left: 0;
    }

    .post {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 6px 16px;
      padding: 22px 0;
    }

    .post-date {
      grid-row: 1;
      grid-column: 1;
    }

    .post-meta {
      grid-row: 1;
      grid-column: 2;
    }

    .post-main {
      grid-column: 1 / -1;
    }

    .post-title {
      font-size: 18px;
    }
  }

  /* ---------- 04 联系 ---------- */
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr));
    gap: 48px;
    align-items: end;
  }

  .contact-lead {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .contact-title {
