---
/**
 * 首页（2026 改版）—— 对应 Design 画板「xuweinan.com 首屏方案」的「已确定」页：
 * 首屏 B1 卡片版 → 00 关于与经历（D-1）→ 01 精选作品 → 02 造物 → 03 博客 → 04 联系 + 页脚。
 * 顶栏暂不改（子页面还没调整），首页沿用 Header 的锚点：#about / #experience / #projects / #contact。
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import MediaSlot from '../components/MediaSlot.astro';
import Icon from '../components/Icon.astro';
import { historical } from '../data/cases';
import { products, tools, games } from '../data/products';
import { formatDate, postSummary } from '../utils';
import { skills, jobs, profile, RESUME_PDF } from '../data/about';

/* ---------- 03 博客：自动取最近 7 篇；简介 = 开头引用块，没写就取正文第一段（显示两行） ---------- */
const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 7)
  .map((post) => ({ ...post, summary: postSummary(post.body) }));

/* ---------- 首屏证据卡 ---------- */
const figmaOf = (label: string) => historical.find((h) => h.label === label)?.figma ?? '/work/';
const proofs = [
  {
    title: 'App Store 4.8 分',
    desc: '漫漫书架 · 原生手写的 iOS 漫画应用',
    href: '/work/comic-manga/',
    img: '/media/products/comic-manga-icon.jpg',
  },
  {
    title: 'GitHub 66 Stars',
    desc: 'Figma 开源插件 · 把 MasterGo 图层迁移到 Figma',
    href: 'https://github.com/AaronXu-Lab/MasterGo2Figma',
    img: '/media/products/mastergo2figma.png',
    external: true,
  },
  {
    title: 'ColorOS 极致体验奖',
    desc: 'OPPO · 年度重点项目 跨屏互联（手机与电脑协同）',
    href: figmaOf('跨屏互联创新项目'),
    icon: 'trophy' as const,
    external: true,
  },
];

const visibleJobs = jobs.filter((j) => !j.draft);
const hasExtraJobs = visibleJobs.some((j) => !j.core);

/* ---------- 01 精选作品 ---------- */
const works = [
  {
    kicker: 'AI 时代的工作方式',
    title: ['我的 Design Agent：', '让 AI 稳定产出可上线的设计稿'],
    desc: '把设计系统、DESIGN.md 和一组自写的 Agent Skill 组合成一个设计 Agent，让 AI 的产出可执行、可校验，并能和开发并行协作。',
    tags: ['DESIGN.md', 'Agent Skills', 'Claude Code'],
    href: '/work/design-engineering-workflow/',
    newTab: true,
    media: { label: 'Design Agent 封面：Agent 工作流 / 产出设计稿' },
  },
  {
    kicker: 'Followup.AI',
    title: ['AI 项目管理平台：', '从 0 到 1 搭建完整设计体系'],
    desc: '在初创团队中主导 AI 项目管理平台从 0 到 1 的全流程设计，搭建设计系统、定义 20+ 种 Column 类型，并探索「意图驱动」的 AI 交互方式。',
    tags: ['初创团队', 'B 端 SaaS', '设计系统', 'AI Agent'],
    href: '/work/followup-ai/',
    media: { label: 'Followup.AI 产品界面', src: '/media/followup/overview.jpg' },
  },
  {
    kicker: '独立设计与开发',
    title: ['漫漫书架：', '一个人设计并写完的漫画阅读器'],
    desc: '支持多格式与多网盘，借助 ComfyUI 把任意漫画页转换成特定画风。从交互到代码都由自己完成，已在 App Store 上线。',
    tags: ['SwiftUI', 'ComfyUI', 'Design to Code'],
    href: '/work/comic-manga/',
    media: { label: '漫漫书架 App 截图', src: '/media/comic/collection.jpg' },
  },
];

const earlyWorks = [
  {
    name: '智能座舱体验度量',
    desc: '把座舱里的感官体验拆成可测的技术指标，填补公司座舱评价体系的空白。',
    href: figmaOf('智能座舱度量体系'),
  },
  {
    name: 'ColorOS 跨屏互联',
    desc: '定义手机、平板与 PC 之间跨端流转的底层交互逻辑，获「极致体验奖」。',
    href: figmaOf('跨屏互联创新项目'),
  },
  {
    name: 'OPPO 车机设计洞察',
    desc: '车机创新预研中的设计洞察，为新驾驶模式的落地与后续规划提供依据。',
    href: figmaOf('OPPO 车机设计洞察'),
  },
  {
    name: '腾讯公益课件 AI 配图',
    desc: '用 ComfyUI 工作流为公益课件生成配图。',
    href: figmaOf('腾讯公益课件 AI 配图'),
  },
];

/* ---------- 02 造物 ---------- */
const productBySlug = (slug: string) => {
  const p = products.find((x) => x.slug === slug);
  if (!p) throw new Error(`products.ts 缺少 ${slug}`);
  return p;
};

const mastergo = productBySlug('mastergo2figma');
const featuredProduct = {
  name: 'MasterGo Importer',
  meta: 'Figma 插件 · 开源',
  desc: 'MasterGo 不支持导出，我写了个 Figma 插件，支持直接解析 .mg 文件，导入回来继续编辑。',
  stat: 'GitHub 66 Stars',
  icon: mastergo.image,
  href: mastergo.links[0].href,
  /** 只放真实评论原文（Figma 社区 / GitHub Issues），注明来源；不要改写或编造 */
  quotes: [] as { text: string; who: string }[],
};

const productCards = [
  {
    slug: 'comic-manga',
    desc: '在 iPad 上收藏和阅读漫画，支持多种格式与云存储，还能用 AI 转换画风。',
    kind: 'iOS / iPadOS · App Store 4.8 分',
  },
  {
    slug: 'seal-note',
    desc: 'macOS 菜单栏里的 Markdown 便签，可选端侧加密。',
    kind: 'macOS · 开源',
  },
  {
    slug: 'lyoon-garment',
    desc: '面向海外客户的染整服装厂官网，展示产品、工艺与行业文章。',
    kind: '品牌官网 · 设计与开发',
  },
].map((c) => {
  const p = productBySlug(c.slug);
  return { ...c, name: p.name, icon: p.image, href: p.links[0].href };
});

const allTools = [...tools, ...games];
const toolPicks = [
  { slug: 'wardrobe', name: '衣集', desc: '把衣服整理成透明底图片并打标签' },
  { slug: 'prompt-lab', name: 'Prompt 擂台', desc: '同一段 Prompt 对比不同模型的实现' },
  { slug: 'stash', name: '暂存箱', desc: '免登录的临时文本与文件中转' },
  { slug: 'focus-forest', name: '专注森林', desc: '专注越久，树长得越高' },
  { slug: 'travel-maps', name: '出发吧打工人', desc: '手账风格的等时旅行地图' },
  { slug: 'mesh-gradient', name: '弥散渐变生成器', desc: '给截图加可调的渐变背景' },
  { slug: 'flying-ninja-cat', name: '飞天忍者猫', desc: '用 Canvas 重制的童年 Flash 跑酷' },
].map((t) => {
  const entry = allTools.find((x) => x.slug === t.slug);
  if (!entry) throw new Error(`products.ts 缺少 ${t.slug}`);
  return {
    ...t,
    icon: entry.icon,
    href: entry.href ?? `/tools/${entry.slug}/`,
    newTab: entry.newTab ?? false,
  };
});

const ext = { target: '_blank', rel: 'noopener' };
---

<Base title="Aaron Xu - 设计工程师 · 个人作品集" scrollspy footer="simple">
  <!-- ================= 首屏 ================= -->
  <section class="hero" data-home-snap>
    <div class="wrap hero-inner">
      <p class="hero-kicker mono-sm reveal">Aaron Xu <span aria-hidden="true">/</span> 设计工程师</p>
      <h1 class="hero-title reveal" style="--d:.05s">
        Design with Code,<br />Think with <span class="accent-text">AI</span>.
      </h1>
      <div class="hero-body">
        <div class="hero-left">
          <p class="hero-intro reveal" style="--d:.12s">
            从 OPPO 的手机系统、小鹏汇天的飞行汽车座舱，再到 flomo，我一直站在设计和工程中间，让想法更快、更准确地变成产品。
          </p>
          <a class="hero-chat reveal" style="--d:.16s" href="#contact">
            <span>想一起做点什么？来聊聊</span><Icon name="arrow-right" size={14} />
          </a>
          <ul class="proofs" role="list">
            {
              proofs.map((p, i) => (
                <li class="reveal" style={`--d:${0.2 + i * 0.06}s`}>
                  <a class="proof" href={p.href} {...(p.external ? ext : {})}>
                    {p.img ? (
                      <img class="proof-icon" src={p.img} alt="" width="40" height="40" />
                    ) : (
                      <span class="proof-icon proof-icon-glyph" aria-hidden="true">
                        <Icon name={p.icon!} size={20} />
                      </span>
                    )}
                    <span class="proof-text">
                      <span class="proof-title">{p.title}</span>
                      <span class="proof-desc">{p.desc}</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <!-- 静态 webp 先出（首屏 + 减少动态效果兜底），空闲时换成 Rive 导出的可动 SVG -->
        <div class="hero-art reveal" style="--d:.18s" data-hero-art data-src="/media/home/quiet-work.json">
          <img
            src="/media/home/hero-illustration.webp"
            alt="戴圆框眼镜、穿橙色毛衣的卡通形象盘腿坐着用笔记本电脑，身旁趴着一只睡着的柴犬，右边放着一杯冒热气的咖啡"
            width="1094"
            height="620"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
    <a class="hero-caret" href="#about" aria-label="向下滚动到关于我">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
    </a>
  </section>

  <!-- ================= 00 关于与经历 ================= -->
  <section id="about" data-spy="about" class="about" aria-labelledby="about-title">
    <div class="wrap">
      <div class="about-body">
        <div class="about-top">
          <div class="about-skip reveal">
            <span class="shiba-mark" aria-hidden="true"></span>
            <button type="button" class="skip-btn" data-about-skip>
              <span>不想看履历？直接看作品</span>
              <Icon name="arrow-down" size={16} />
            </button>
          </div>

          <div class="about-card reveal" style="--d:.06s">
            <div class="about-head">
              <div class="about-head-row">
                <h2 id="about-title" class="sec-label"><span class="sec-num mono-sm">00</span>关于我</h2>
                <a class="ghost-btn resume-btn" href={RESUME_PDF} download="Aaron Xu 简历.pdf">
                  <Icon name="download-simple" size={16} />下载简历
                </a>
              </div>
              <p class="about-hello">
                {profile.hello.before}<span class="accent-text">{profile.hello.accent}</span>{profile.hello.after}
              </p>
              <p class="about-edu">
                <Icon name="graduation-cap" size={18} />
                <span><strong>{profile.education.school}</strong> · {profile.education.detail}</span>
              </p>
            </div>
            <ul class="skills" role="list">
              {
                skills.map((s) => (
                  <li class="skill">
                    <span class="skill-icon" aria-hidden="true">
                      <Icon name={s.icon} size={22} />
                    </span>
                    <h3>{s.title}</h3>
                    <p>{s.desc}</p>
                    {s.tools && <span class="skill-tools mono-sm">{s.tools}</span>}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <section id="experience" data-spy="experience" class="exp" aria-labelledby="exp-title">
          <h3 id="exp-title" class="exp-title reveal">工作经历</h3>
          <ol class="jobs" data-jobs role="list">
            {
              visibleJobs.map((job) => (
                <li class:list={['job', 'reveal', { 'job-extra': !job.core, current: job.current }]}>
                  <div class="job-when">
                    <span class="job-span">{job.span}</span>
                    <span class="job-time mono-sm">{job.time}</span>
                  </div>
                  <div class="job-rail" aria-hidden="true">
                    <span class="job-dot" />
                  </div>
                  <div class="job-main">
                    <div class="job-info">
                      <span class="job-company">{job.company}</span>
                      <span class="job-role">{job.role}</span>
                      {job.badge && (
                        <span class:list={['job-badge', `tone-${job.badge.tone}`]}>{job.badge.text}</span>
                      )}
                      <span class="job-domain">{job.domain}</span>
                      {job.link && (
                        <a class="job-link" href={job.link.href} {...(job.link.external ? ext : {})}>
                          {job.link.label} {job.link.external ? '↗' : '→'}
                        </a>
                      )}
                    </div>
                    <ul class="job-points" role="list">
                      {job.points.map((p) => (
                        <li>{p}</li>
                      ))}
                    </ul>
                  </div>
                </li>
              ))
            }
          </ol>
          {
            hasExtraJobs && (
              <button type="button" class="ghost-btn jobs-toggle" data-jobs-toggle aria-expanded="false">
                更多经历 ↓
              </button>
            )
          }
        </section>
      </div>
    </div>
  </section>

  <!-- ================= 01 精选作品 ================= -->
  <section id="work" data-spy="projects" class="block work" aria-labelledby="work-title">
    <span id="projects" class="anchor-alias" aria-hidden="true"></span>
    <div class="wrap block-inner">
      <div class="sec-head reveal">
        <div class="sec-titles">
          <h2 id="work-title" class="sec-label" tabindex="-1"><span class="sec-num mono-sm">01</span>精选作品</h2>
          <p class="sec-statement">让设计与代码一起跳舞，把产品做完整。</p>
        </div>
        <a class="more-link" href="/work/">全部作品<Icon name="arrow-right" size={14} /></a>
      </div>

      <div class="works">
        {
          works.map((w, i) => (
            <article class:list={['work-row', 'reveal', { flip: i % 2 === 1 }]}>
              <a
                class="work-cover"
                href={w.href}
                aria-label={`阅读案例：${w.title.join('')}`}
                {...(w.newTab ? ext : {})}
              >
                <MediaSlot label={w.media.label} ratio="16 / 10" src={w.media.src} />
              </a>
              <div class="work-text">
                <span class="work-kicker">{w.kicker}</span>
                <h3 class="work-title">
                  {w.title[0]}
                  <br />
                  {w.title[1]}
                </h3>
                <p class="work-desc">{w.desc}</p>
                <ul class="tags" role="list">
                  {w.tags.map((t) => (
                    <li class="tag">{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>

      <div class="early reveal">
        <span class="early-label">更早的作品</span>
        <ul class="early-list" role="list">
          {
            earlyWorks.map((e, i) => (
              <li class="early-item">
                <a href={e.href} {...ext} aria-describedby={`early-${i}`}>{e.name}</a>
                <span class="early-pop" role="tooltip" id={`early-${i}`}>{e.desc}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ================= 02 造物 ================= -->
  <section id="lab" class="block lab" aria-labelledby="lab-title">
    <div class="wrap block-inner">
      <div class="sec-head reveal">
        <div class="sec-titles">
          <h2 id="lab-title" class="sec-label"><span class="sec-num mono-sm">02</span>造物</h2>
          <p class="sec-statement">工作之外，我做的东西。</p>
          <p class="sec-desc">从设计到代码都由我独立完成：四个长期维护的产品，和一些顺手做的小工具、小游戏。</p>
        </div>
        <a class="more-link" href="/products/">全部造物<Icon name="arrow-right" size={14} /></a>
      </div>

      <div class="lab-group">
        <h3 class="group-title reveal">大产品</h3>
        <a
          class:list={['feature', 'reveal', { 'has-quotes': featuredProduct.quotes.length > 0 }]}
          href={featuredProduct.href}
          {...ext}
        >
          <div class="feature-main">
            <div class="feature-meta">
              <img src={featuredProduct.icon} alt="" width="44" height="44" />
              <span>{featuredProduct.meta}</span>
            </div>
            <span class="feature-name">{featuredProduct.name}</span>
            <span class="feature-desc">{featuredProduct.desc}</span>
            <span class="feature-stat">{featuredProduct.stat}</span>
          </div>
          {
            featuredProduct.quotes.length > 0 && (
              <figure class="feature-quotes">
                <figcaption>用户怎么说</figcaption>
                {featuredProduct.quotes.map((q) => (
                  <blockquote>
                    <p>“{q.text}”</p>
                    <cite>{q.who}</cite>
                  </blockquote>
                ))}
              </figure>
            )
          }
        </a>
        <ul class="product-cards" role="list">
          {
            productCards.map((p, i) => (
              <li class="reveal" style={`--d:${i * 0.06}s`}>
                <a class="product-card" href={p.href} {...ext}>
                  <span class="product-head">
                    <img src={p.icon} alt="" width="40" height="40" />
                    <span class="product-name">{p.name}</span>
                  </span>
                  <span class="product-desc">{p.desc}</span>
                  <span class="product-kind">{p.kind}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lab-group">
        <h3 class="group-title reveal">小工具 <span>和游戏</span></h3>
        <ul class="tool-list reveal" role="list">
          {
            toolPicks.map((t) => (
              <li>
                <a class="tool-row" href={t.href} {...(t.newTab ? ext : {})}>
                  <img class="tool-icon" src={t.icon} alt="" width="32" height="32" />
                  <span class="tool-text">
                    <span class="tool-name">{t.name}</span>
                    <span class="tool-desc">{t.desc}</span>
                  </span>
                </a>
              </li>
            ))
          }
          <li>
            <a class="tool-row tool-all" href="/products/#sec-tools">
              <span class="tool-icon tool-icon-glyph" aria-hidden="true"><Icon name="squares-four" size={20} /></span>
              <span class="tool-name">查看全部小工具</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ================= 03 博客 ================= -->
  <section id="blog" class="block blog" aria-labelledby="blog-title">
    <div class="wrap block-inner">
      <div class="sec-head reveal">
        <div class="sec-titles">
          <h2 id="blog-title" class="sec-label"><span class="sec-num mono-sm">03</span>博客</h2>
          <p class="sec-statement">最近在想的事。</p>
          <p class="sec-desc">一个设计师的笔记本：工作上的思考，也有工作之外的爱好。</p>
        </div>
        <a class="more-link" href="/blog/">全部文章<Icon name="arrow-right" size={14} /></a>
      </div>

      <ol class="posts" role="list">
        {
          posts.map((post, i) => (
            <li class="reveal" style={`--d:${i * 0.04}s`}>
              <a class="post" href={`/blog/${post.id}/`}>
                <time class="post-date mono-sm" datetime={post.data.date.toISOString()}>
                  {formatDate(post.data.date)}
                </time>
                <span class="post-main">
                  <span class="post-title">{post.data.title}</span>
                  {post.summary && <span class="post-desc">{post.summary}</span>}
                </span>
                <span class="post-meta">
                  {[post.data.categories[0], post.data.minutes && `${post.data.minutes} min`]
                    .filter(Boolean)
                    .join(' · ')}
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ================= 04 联系 ================= -->
  <section id="contact" data-spy="contact" class="block contact" aria-labelledby="contact-title">
    <div class="wrap block-inner contact-grid">
      <div class="contact-lead reveal">
        <p class="sec-label"><span class="sec-num mono-sm">04</span>联系</p>
        <h2 id="contact-title" class="contact-title">Let's <span class="accent-text">talk</span>.</h2>
        <p class="contact-copy">有合适的机会，或者想聊聊设计、代码和 AI，都欢迎来信。邮件是最快的方式。</p>
        <a class="btn contact-mail" href="mailto:woshixwn@gmail.com">
          woshixwn@gmail.com <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
      <dl class="channels reveal" style="--d:.08s">
        <div class="channel">
          <dt><span class="channel-icon channel-icon-text" aria-hidden="true">书</span>小红书</dt>
          <dd>
            <button type="button" data-copy="6364222434" aria-label="复制小红书号 6364222434">
              <span data-copy-label>6364222434</span>
              <span class="copy-hint mono-sm" aria-hidden="true"><span class="copy-text">复制</span><svg class="copy-check" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor"><path d="M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z"/></svg></span>
              <span class="copy-status" role="status"></span>
            </button>
          </dd>
