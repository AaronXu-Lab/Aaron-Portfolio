<script>
  // ---- 首屏插图动画：重放 Rive 项目导出的关键帧（数据由 scripts/import-hero-animation.mjs 生成） ----
  type Key = [number, number, [number, number, number, number] | 'hold' | null];
  interface Anim {
    dur: number;
    fps: number;
    tracks: { o: string; p: string; k: Key[] }[];
  }
  type Pose = Record<'x' | 'y' | 'rotation' | 'scaleX' | 'scaleY' | 'opacity', number>;
  interface Pack {
    viewBox: string;
    svg: string;
    anims: Anim[];
    base: Record<string, Pose>;
  }

  /** cubic-bezier 缓动：解 x(t) = p，返回 y(t) */
  const bezier = ([x1, y1, x2, y2]: [number, number, number, number], p: number) => {
    const cx = 3 * x1, bx = 3 * (x2 - x1) - cx, ax = 1 - cx - bx;
    const cy = 3 * y1, by = 3 * (y2 - y1) - cy, ay = 1 - cy - by;
    const X = (t: number) => ((ax * t + bx) * t + cx) * t;
    const dX = (t: number) => (3 * ax * t + 2 * bx) * t + cx;
    let t = p;
    for (let i = 0; i < 8; i++) {
      const err = X(t) - p, d = dX(t);
      if (Math.abs(err) < 1e-6 || Math.abs(d) < 1e-6) break;
      t -= err / d;
    }
    if (t < 0 || t > 1 || Math.abs(X(t) - p) > 1e-4) {
      let lo = 0, hi = 1;
      t = p;
      for (let i = 0; i < 30; i++) {
        const x = X(t);
        if (Math.abs(x - p) < 1e-6) break;
        if (x < p) lo = t;
        else hi = t;
        t = (lo + hi) / 2;
      }
    }
    return ((ay * t + by) * t + cy) * t;
  };

  const sample = (keys: Key[], f: number) => {
    if (f <= keys[0][0]) return keys[0][1];
    const last = keys[keys.length - 1];
    if (f >= last[0]) return last[1];
    for (let i = 0; i < keys.length - 1; i++) {
      const a = keys[i], b = keys[i + 1];
      if (f < b[0]) {
        if (a[2] === 'hold') return a[1];
        let p = (f - a[0]) / (b[0] - a[0]);
        if (Array.isArray(a[2])) p = bezier(a[2], p);
        return a[1] + (b[1] - a[1]) * p;
      }
    }
    return last[1];
  };

  const mountHeroAnimation = async (holder: HTMLElement) => {
    const pack: Pack = await fetch(holder.dataset.src!).then((r) => {
      if (!r.ok) throw new Error(String(r.status));
      return r.json();
    });
    const img = holder.querySelector('img');
    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    svg.setAttribute('viewBox', pack.viewBox);
    svg.setAttribute('role', 'img');
    svg.setAttribute('aria-label', img?.alt ?? '');
    svg.innerHTML = pack.svg;

    const els = new Map<string, Element>();
    for (const id in pack.base) {
      const el = svg.querySelector(`#qw-o${id.replace(':', '_')}`);
      if (el) els.set(id, el);
    }
    const deg = 180 / Math.PI;
    const render = (seconds: number) => {
      const state: Record<string, Pose> = {};
      for (const id in pack.base) state[id] = { ...pack.base[id] };
      for (const a of pack.anims) {
        const f = (seconds * a.fps) % a.dur;
        for (const tr of a.tracks) {
          if (state[tr.o]) state[tr.o][tr.p as keyof Pose] = sample(tr.k, f);
        }
      }
      for (const [id, el] of els) {
        const s = state[id];
        el.setAttribute(
          'transform',
          `translate(${s.x} ${s.y}) rotate(${s.rotation * deg}) scale(${s.scaleX} ${s.scaleY})`
        );
        if (s.opacity !== 1 || el.hasAttribute('opacity')) el.setAttribute('opacity', String(s.opacity));
      }
    };

    // 第 0 帧与静态插图一致，直接替换不跳位
    render(0);
    holder.append(svg);
    img?.remove();

    // 只在插图可见时播放；离开视口暂停，回来接着播
    let raf = 0;
    let elapsed = 0;
    let last: number | null = null;
    const tick = (now: number) => {
      if (last !== null) elapsed += Math.min(now - last, 100);
      last = now;
      render(elapsed / 1000);
      raf = requestAnimationFrame(tick);
    };
    new IntersectionObserver(([e]) => {
      cancelAnimationFrame(raf);
      last = null;
      if (e.isIntersecting) raf = requestAnimationFrame(tick);
    }).observe(holder);
  };

  const heroArt = document.querySelector<HTMLElement>('[data-hero-art]');
  const still =
    matchMedia('(prefers-reduced-motion: reduce)').matches ||
    document.documentElement.hasAttribute('data-qa');
  if (heroArt && !still) {
    const start = () =>
      mountHeroAnimation(heroArt).catch(() => {
        /* 加载失败就保留静态插图 */
      });
    const idle = () =>
      'requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 2500 }) : setTimeout(start, 600);
    if (document.readyState === 'complete') idle();
    else addEventListener('load', idle, { once: true });
  }

  // 00 关于：「直接看作品」滚到 01 精选作品（不折叠本屏）；「更多经历」展开非核心经历
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelector('[data-about-skip]')?.addEventListener('click', () => {
    // 先把焦点交给 01 的标题（键盘用户接着往下 Tab），再平滑滚动；顺序反过来 focus 会打断滚动
    document.getElementById('work-title')?.focus({ preventScroll: true });
    document.getElementById('work')?.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
  });

  const jobs = document.querySelector<HTMLElement>('[data-jobs]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-jobs-toggle]');
  toggle?.addEventListener('click', () => {
    const open = !jobs?.classList.contains('show-all');
    jobs?.classList.toggle('show-all', open);
    // 展开出来的条目不等入场动画，直接可见
    jobs?.querySelectorAll('.job-extra').forEach((el) => el.classList.add('in'));
    toggle.setAttribute('aria-expanded', String(open));
    toggle.textContent = open ? '收起 ↑' : '更多经历 ↓';
  });
</script>

