      </ol>

      <TextLink href="/blog/" class="blog-all reveal">全部文章</TextLink>
    </div>
  </section>

  <!-- ================= 04 联系 ================= -->
  <section id="contact" data-spy="contact" class="block contact" aria-labelledby="contact-title">
    <div class="wrap block-inner contact-grid">
      <div class="contact-lead reveal">
        <p class="sec-label"><span class="sec-num mono-sm">04</span>联系</p>
        <h2 id="contact-title" class="contact-title">Let's <span class="accent-text">talk</span>.</h2>
        <p class="contact-copy"><span>有合适的机会，或者想聊聊设计、代码和 AI，都欢迎来信。</span><span>我的邮箱现在通过 AI 管理，所以通过邮件沟通会比较高效。</span></p>
        <a class="btn btn-sm contact-mail" href="mailto:woshixwn@gmail.com">
          woshixwn@gmail.com <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
      <dl class="channels reveal" style="--d:.08s">
        <div class="channel">
          <dt><span class="channel-icon" aria-hidden="true"><Icon name="book" size={14} /></span>小红书</dt>
          <dd>
            <!-- 与 GitHub 一行同一套交互：整行（数字 + 图标）都是一个可点的按钮，悬停时文字和图标一起变色；图标容器同为 28px -->
            <button type="button" class="channel-copy" title="复制" data-copy="6364222434" aria-label="复制小红书号 6364222434">
              <span class="channel-value">6364222434</span>
              <span class="channel-arrow copy-hint" aria-hidden="true"><span class="copy-text"><Icon name="copy" size={14} /></span><svg class="copy-check" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor"><path d="M229.66,77.66l-128,128a8,8,0,0,1-11.32,0l-56-56a8,8,0,0,1,11.32-11.32L96,188.69,218.34,66.34a8,8,0,0,1,11.32,11.32Z"/></svg></span>
              <span class="copy-status" role="status"></span>
            </button>
          </dd>
        </div>
        <div class="channel">
          <dt><span class="channel-icon" aria-hidden="true"><Icon name="github-logo" size={14} /></span>GitHub</dt>
          <dd>
            <!-- 箭头容器与复制按钮同尺寸（28px）以便上下对齐；它不是按钮，没有底色效果，悬停时整行变色；整行仍是一个链接，整行都能点 -->
            <a href="https://github.com/AaronXu-Lab" {...ext} aria-label="GitHub：AaronXu-Lab（新标签页打开）">
              <span class="channel-value">AaronXu-Lab</span>
              <span class="channel-arrow" aria-hidden="true"><Icon name="arrow-up-right" size={14} /></span>
            </a>
          </dd>
        </div>
        <div class="channel">
          <dt><span class="channel-icon" aria-hidden="true"><Icon name="wechat-logo" size={14} /></span>WeChat</dt>
          <dd>
            <!-- 与 GitHub 一行同一套交互：整行（数字 + 图标）都是一个可点的按钮，悬停时文字和图标一起变色；图标容器同为 28px -->
            <button type="button" class="channel-copy" title="复制" data-copy="woshixwn123" aria-label="复制微信号 woshixwn123">
              <span class="channel-value">woshixwn123</span>
              <span class="channel-arrow copy-hint" aria-hidden="true"><span class="copy-text"><Icon name="copy" size={14} /></span><svg class="copy-check" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor"><path d="M229.66,77.66l-128,128a8,8,0,0,1-11.32,0l-56-56a8,8,0,0,1,11.32-11.32L96,188.69,218.34,66.34a8,8,0,0,1,11.32,11.32Z"/></svg></span>
              <span class="copy-status" role="status"></span>
            </button>
          </dd>
        </div>
      </dl>
    </div>
  </section>
  </div>
</Base>

<script>
  // ---- 首屏插图动画：重放 Rive 项目导出的关键帧（数据由 scripts/import-hero-animation.mjs 生成） ----
  type Key = [number, number, [number, number, number, number] | 'hold' | null];
  interface Anim {
    dur: number;
    fps: number;
    tracks: { o: string; p: string; k: Key[] }[];
  }
  type Pose = Record<'x' | 'y' | 'rotation' | 'scaleX' | 'scaleY' | 'opacity', number>;
  interface Pack {
    viewBox: string;
    svg: string;
    anims: Anim[];
    base: Record<string, Pose>;
  }

  /** cubic-bezier 缓动：解 x(t) = p，返回 y(t) */
  const bezier = ([x1, y1, x2, y2]: [number, number, number, number], p: number) => {
    const cx = 3 * x1, bx = 3 * (x2 - x1) - cx, ax = 1 - cx - bx;
    const cy = 3 * y1, by = 3 * (y2 - y1) - cy, ay = 1 - cy - by;
    const X = (t: number) => ((ax * t + bx) * t + cx) * t;
    const dX = (t: number) => (3 * ax * t + 2 * bx) * t + cx;
    let t = p;
    for (let i = 0; i < 8; i++) {
      const err = X(t) - p, d = dX(t);
      if (Math.abs(err) < 1e-6 || Math.abs(d) < 1e-6) break;
      t -= err / d;
    }
    if (t < 0 || t > 1 || Math.abs(X(t) - p) > 1e-4) {
      let lo = 0, hi = 1;
      t = p;
      for (let i = 0; i < 30; i++) {
        const x = X(t);
        if (Math.abs(x - p) < 1e-6) break;
        if (x < p) lo = t;
        else hi = t;
        t = (lo + hi) / 2;
      }
    }
    return ((ay * t + by) * t + cy) * t;
  };

  const sample = (keys: Key[], f: number) => {
    if (f <= keys[0][0]) return keys[0][1];
    const last = keys[keys.length - 1];
    if (f >= last[0]) return last[1];
    for (let i = 0; i < keys.length - 1; i++) {
      const a = keys[i], b = keys[i + 1];
      if (f < b[0]) {
        if (a[2] === 'hold') return a[1];
        let p = (f - a[0]) / (b[0] - a[0]);
        if (Array.isArray(a[2])) p = bezier(a[2], p);
        return a[1] + (b[1] - a[1]) * p;
      }
    }
    return last[1];
  };

  const mountHeroAnimation = async (holder: HTMLElement) => {
    const pack: Pack = await fetch(holder.dataset.src!).then((r) => {
      if (!r.ok) throw new Error(String(r.status));
      return r.json();
    });
    const img = holder.querySelector('img');
    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    svg.setAttribute('viewBox', pack.viewBox);
    svg.setAttribute('role', 'img');
    svg.setAttribute('aria-label', img?.alt ?? '');
    svg.innerHTML = pack.svg;

    const els = new Map<string, Element>();
    for (const id in pack.base) {
      const el = svg.querySelector(`#qw-o${id.replace(':', '_')}`);
      if (el) els.set(id, el);
    }
    const deg = 180 / Math.PI;
    const render = (seconds: number) => {
      const state: Record<string, Pose> = {};
      for (const id in pack.base) state[id] = { ...pack.base[id] };
      for (const a of pack.anims) {
        const f = (seconds * a.fps) % a.dur;
        for (const tr of a.tracks) {
          if (state[tr.o]) state[tr.o][tr.p as keyof Pose] = sample(tr.k, f);
        }
      }
      for (const [id, el] of els) {
        const s = state[id];
        el.setAttribute(
          'transform',
          `translate(${s.x} ${s.y}) rotate(${s.rotation * deg}) scale(${s.scaleX} ${s.scaleY})`
        );
        if (s.opacity !== 1 || el.hasAttribute('opacity')) el.setAttribute('opacity', String(s.opacity));
      }
    };

    // 第 0 帧与静态插图一致，直接替换不跳位
    render(0);
    holder.append(svg);
    img?.remove();

    // 只在插图可见时播放；离开视口暂停，回来接着播
    let raf = 0;
    let elapsed = 0;
    let last: number | null = null;
    const tick = (now: number) => {
      if (last !== null) elapsed += Math.min(now - last, 100);
      last = now;
      render(elapsed / 1000);
      raf = requestAnimationFrame(tick);
    };
    new IntersectionObserver(([e]) => {
      cancelAnimationFrame(raf);
      last = null;
      if (e.isIntersecting) raf = requestAnimationFrame(tick);
    }).observe(holder);
  };

  const heroArt = document.querySelector<HTMLElement>('[data-hero-art]');
  const still =
    matchMedia('(prefers-reduced-motion: reduce)').matches ||
    document.documentElement.hasAttribute('data-qa');
  if (heroArt && !still) {
    const start = () =>
      mountHeroAnimation(heroArt).catch(() => {
        /* 加载失败就保留静态插图 */
      });
    const idle = () =>
      'requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 2500 }) : setTimeout(start, 600);
    if (document.readyState === 'complete') idle();
    else addEventListener('load', idle, { once: true });
  }

  // 00 关于：「直接看作品」滚到 01 精选作品（不折叠本屏）；「更多经历」展开非核心经历
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelector('[data-about-skip]')?.addEventListener('click', () => {
    // 先把焦点交给 01 的标题（键盘用户接着往下 Tab），再平滑滚动；顺序反过来 focus 会打断滚动
    document.getElementById('work-title')?.focus({ preventScroll: true });
    document.getElementById('work')?.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
  });

  // 页内锚点（首屏向下箭头、「来聊聊」、顶栏「关于/联系我」、回到顶部）：平滑滚动到目标，但不把 #hash 留在地址栏。
  // 否则刷新或从别的页面返回时，浏览器会按 hash 又跳回 00 的顶部。
  document.addEventListener('click', (e) => {
    const link = (e.target as Element).closest<HTMLAnchorElement>('a[href]');
    if (!link || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    if (link.target === '_blank' || link.hasAttribute('download')) return;
    const url = new URL(link.href, location.href);
    if (url.origin !== location.origin || url.pathname !== location.pathname || !url.hash || url.hash === '#main') return;
    const id = decodeURIComponent(url.hash.slice(1));
    const target = id === 'top' ? null : document.getElementById(id);
    if (id !== 'top' && !target) return;
    e.preventDefault();
    const behavior = reduced ? 'auto' : 'smooth';
    if (target) target.scrollIntoView({ behavior, block: 'start' });
    else scrollTo({ top: 0, behavior });
    history.replaceState(null, '', url.pathname + url.search);
  });

  // 从别的页面带 #hash 进来时，落位后同样把 hash 去掉，刷新会按浏览器记住的滚动位置恢复，不再每次跳回锚点
  const dropHash = () => {
    if (location.hash && location.hash !== '#main') history.replaceState(null, '', location.pathname + location.search);
  };
  if (document.readyState === 'complete') dropHash();
  else addEventListener('load', dropHash, { once: true });
  addEventListener('hashchange', dropHash);

  const jobs = document.querySelector<HTMLElement>('[data-jobs]');
  // 折叠中的经历由 .job-inner 自己控制显隐，不再等入场动画
  jobs?.querySelectorAll('.job-extra').forEach((el) => el.classList.add('in'));
  const toggle = document.querySelector<HTMLButtonElement>('[data-jobs-toggle]');
  toggle?.addEventListener('click', () => {
    const open = !jobs?.classList.contains('show-all');
    jobs?.classList.toggle('show-all', open);
    // 展开出来的条目不等入场动画，直接可见
    jobs?.querySelectorAll('.job-extra').forEach((el) => el.classList.add('in'));
    toggle.setAttribute('aria-expanded', String(open));
    const label = toggle.querySelector('[data-jobs-label]');
    if (label) label.textContent = open ? '收起' : '更多经历';
  });

  /*
   * 00 关于：四个能力图标轮流自动播放微动效（加 .si-play，动画本身在 SkillIcon.astro）。
   * - 没有悬停时：第 1 个播完隔 GAP 播第 2 个……循环；区块不在视口内时暂停。
   * - 悬停某一张：暂停轮播；正在播的那个照常播完，被悬停的那个同时开始播；
   *   移开后从被悬停的下一个接着轮播。
   * - prefers-reduced-motion 下不轮播（动效本身也已关闭）。
   */
  const skillList = document.querySelector<HTMLElement>('[data-skills]');
  const skillItems = skillList ? [...skillList.querySelectorAll<HTMLElement>('.skill')] : [];
  if (skillList && skillItems.length && !reduced) {
    const GAP = 500;
    const durRaw = getComputedStyle(skillList.querySelector('.si') ?? skillList).getPropertyValue('--si-dur').trim();
    const DUR = (parseFloat(durRaw) || 0.9) * (durRaw.endsWith('ms') ? 1 : 1000);

    const startedAt = new Map<HTMLElement, number>();
    const endTimers = new Map<HTMLElement, number>();
    let next = 0;
    let loopTimer = 0;
    let hovering = false;
    let inView = false;

    const isPlaying = (el: HTMLElement) => el.classList.contains('si-play');

    const play = (el: HTMLElement) => {
      clearTimeout(endTimers.get(el));
      el.classList.remove('si-play');
      void el.offsetWidth; // 移除再加，确保动画从头开始
      el.classList.add('si-play');
      startedAt.set(el, performance.now());
      endTimers.set(el, window.setTimeout(() => el.classList.remove('si-play'), DUR));
    };

    const schedule = (delay: number) => {
      clearTimeout(loopTimer);
      if (hovering || !inView) return;
      loopTimer = window.setTimeout(() => {
        play(skillItems[next]);
        next = (next + 1) % skillItems.length;
        schedule(DUR + GAP);
      }, delay);
    };

    skillItems.forEach((el, i) => {
      const enter = () => {
        hovering = true;
        clearTimeout(loopTimer);
        if (!isPlaying(el)) play(el);
        next = (i + 1) % skillItems.length;
      };
      el.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && enter());
      el.addEventListener('pointerleave', (e) => {
        if (e.pointerType !== 'mouse') return;
        hovering = false;
        const left = Math.max(0, DUR - (performance.now() - (startedAt.get(el) ?? 0)));
        schedule(left + GAP);
      });
      // 触屏：按下即播，轮播从它的下一个接着走
      el.addEventListener('pointerdown', (e) => {
        if (e.pointerType === 'mouse') return;
        if (!isPlaying(el)) play(el);
        next = (i + 1) % skillItems.length;
        schedule(DUR + GAP);
      });
    });

    new IntersectionObserver(([e]) => {
      inView = e.isIntersecting;
      if (inView) schedule(GAP);
      else clearTimeout(loopTimer);
    }).observe(skillList);
  }
</script>

