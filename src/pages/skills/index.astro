---
import Icon from '../../components/Icon.astro';
import SkillCard from '../../components/SkillCard.astro';
import SkillSheet from '../../components/SkillSheet.astro';
import Base from '../../layouts/Base.astro';
import { skills } from '../../data/skills';

const groups = [
  { id: 'design-agent', title: 'Design Agent', en: 'Design & UX' },
  { id: 'other', title: '其他', en: 'Other Skills' },
] as const;
---

<Base
  title="Skill - Aaron Xu"
  description="Aaron Xu 自己编写的 Agent Skill:让 AI 编程助手长出趁手的专业能力。"
>
  <div class="skills-page container">
    <header class="page-head">
      <!-- Skill 页是造物的子页面：顶部给一个返回上级的入口，回到造物页的 Agent Skills 区块 -->
      <a class="back-link reveal" href="/products/#sec-skills">
        <Icon name="arrow-left" size={14} />
        造物
      </a>
      <div class="mono-label reveal">Skills · Hand-crafted</div>
      <h1 class="display reveal" style="--d:.05s">自写<span class="accent-text"> Skill</span>.</h1>
      <p class="lead reveal" style="--d:.1s">
        为 Claude Code 等 AI 编程助手编写的技能包 ——
        把一件事的最佳做法沉淀成可复用的指令，让 Agent 一次学会、次次做好。
      </p>
    </header>

    {
      skills.length > 0 ? (
        <>
          {groups.map((group) => (
            <section class="block" aria-labelledby={`section-${group.id}`}>
              <button class="section-head section-toggle reveal" type="button" aria-expanded="true" aria-controls={`panel-${group.id}`}>
                <span class="zh" id={`section-${group.id}`}>{group.title}</span>
                <span class="en">{group.en}</span>
                <Icon name="caret-down" size={15} class="toggle-caret" />
              </button>
              <div class="collapse" id={`panel-${group.id}`}>
              <div class="collapse-inner">
              <ol class="skill-list">
          {skills.filter((s) => s.group === group.id).map((s, i) => (
            <li class="reveal" style={`--d:${0.05 * i}s`}>
              <SkillCard skill={s} sheet />
            </li>
          ))}
              </ol>
              </div>
              </div>
            </section>
          ))}
          <SkillSheet skills={skills} />
        </>
      ) : (
        <div class="empty-state reveal" style="--d:.15s">
          <div class="mono-label">COMING SOON</div>
          <p class="empty-title">第一批 Skill 正在打磨中。</p>
          <p class="empty-desc">
            日常工作里被反复验证过的做法，才值得固化成 Skill。
            近期会陆续把设计工程与 AI 工作流方向的几个技能包整理上架 ——
            在此之前，可以先去<a href="/blog/">博客</a>看看它们的由来。
          </p>
        </div>
      )
    }
  </div>
</Base>

<script>
  // Section 折叠:grid-template-rows 0fr↔1fr 的可中断 transition,caret 旋转指示
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.section-toggle')) {
    btn.addEventListener('click', () => {
      const block = btn.closest('.block');
      if (!block) return;
      const collapsed = block.classList.toggle('collapsed');
      btn.setAttribute('aria-expanded', String(!collapsed));
    });
  }
</script>

<style>
  /* 页头节奏与博客/组件页保持一致 */
  .skills-page {
    padding-top: clamp(112px, 15vw, 168px);
  }

  .page-head {
    margin-bottom: clamp(40px, 6vw, 64px);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 28px;
    padding: 6px 12px 6px 10px;
    border-radius: var(--radius-pill);
    color: var(--text-2);
    font-size: 14px;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .back-link :global(svg) {
    transition: transform 0.25s var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .back-link:hover {
      color: var(--text);
      background: color-mix(in oklch, var(--text) 6%, transparent);
    }

    .back-link:hover :global(svg) {
      transform: translateX(-3px);
    }
  }

  .back-link:active {
    background: color-mix(in oklch, var(--text) 9%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .back-link :global(svg) {
      transition: none;
    }
  }

  .page-head .mono-label {
    display: block;
    margin-bottom: 22px;
  }

  .page-head h1 {
    margin-bottom: 22px;
  }

  .page-head .lead {
    max-width: 58ch;
  }

  .block + .block {
    margin-top: clamp(56px, 8vw, 88px);
  }

  /* ---- 可折叠 Section 头(button 化,复用 .section-head 视觉) ---- */
  .section-toggle {
    appearance: none;
    -webkit-appearance: none;
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--border);
    text-align: left;
    color: inherit;
    font: inherit;
    cursor: pointer;
    /* 头本身不再留下方间距,间距挪进可折叠区,折叠时一并收起 */
    margin-bottom: 0;
    transition: border-color 0.2s ease;
  }

  /* caret 是 <Fragment set:html> 注入的原始 svg,拿不到 Astro 作用域属性,故用 :global */
  .section-toggle :global(.toggle-caret) {
    margin-left: auto;
    align-self: center;
    color: var(--text-3);
    transition: transform 0.28s var(--ease-out), color 0.2s ease;
  }

  .section-toggle:hover :global(.toggle-caret) {
    color: var(--accent-strong);
  }

  /* 折叠态:caret 转到向上(默认向下 = 展开) */
  .block.collapsed :global(.toggle-caret) {
    transform: rotate(-180deg);
  }

  .collapse {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.34s var(--ease-out), opacity 0.26s ease;
  }

  /* 裁剪层:不带内边距,才能被 0fr 轨道压到 0 */
  /* 裁剪层向左右、下方各外扩一圈，卡片悬停的阴影（向下约 30px、两侧约 15px）不会被 overflow 切掉；
     列表再用等量 padding 缩回来，版面位置不变 */
  .collapse-inner {
    min-height: 0;
    overflow: hidden;
    margin: 0 -24px -40px;
  }

  /* 头与列表间距活在裁剪层内部,折叠时一并收起 */
  .collapse-inner > :global(ol) {
    padding: clamp(28px, 4vw, 44px) 24px 40px;
  }

  .block.collapsed .collapse {
    grid-template-rows: 0fr;
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .collapse {
      transition: opacity 0.2s ease;
    }
  }

  .skill-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    /* 内容区 1192px 下一行五张 */
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr));
    gap: 16px;
  }

  .empty-state {
    max-width: 620px;
    padding: clamp(32px, 5vw, 48px);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .empty-title {
    margin-top: 14px;
    font-size: clamp(19px, 2.4vw, 22px);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .empty-desc {
    margin-top: 10px;
    color: var(--text-2);
    line-height: 1.8;
  }

  .empty-desc a {
    color: var(--accent-strong);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
