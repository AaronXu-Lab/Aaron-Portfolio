---
import Icon from '../../components/Icon.astro';
import Base from '../../layouts/Base.astro';
import { skills } from '../../data/skills';

const groups = [
  { id: 'design-agent', title: 'Design Agent', en: 'Design & UX' },
  { id: 'other', title: '其他', en: 'Other Skills' },
] as const;
---

<Base
  title="Skill - Aaron Xu"
  description="Aaron Xu 自己编写的 Agent Skill:让 AI 编程助手长出趁手的专业能力。"
>
  <div class="skills-page container">
    <header class="page-head">
      <div class="mono-label reveal">Skills · Hand-crafted</div>
      <h1 class="display reveal" style="--d:.05s">自写<span class="accent-text"> Skill</span>.</h1>
      <p class="lead reveal" style="--d:.1s">
        为 Claude Code 等 AI 编程助手编写的技能包 ——
        把一件事的最佳做法沉淀成可复用的指令，让 Agent 一次学会、次次做好。
      </p>
    </header>

    {
      skills.length > 0 ? (
        <>
          {groups.map((group, index) => (
            <section class="block" aria-labelledby={`section-${group.id}`}>
              <button class="section-head section-toggle reveal" type="button" aria-expanded="true" aria-controls={`panel-${group.id}`}>
                <span class="num">{String(index + 1).padStart(2, '0')}</span>
                <span class="zh" id={`section-${group.id}`}>{group.title}</span>
                <span class="en">{group.en}</span>
                <Icon name="caret-down" size={15} class="toggle-caret" />
              </button>
              <div class="collapse" id={`panel-${group.id}`}>
              <div class="collapse-inner">
              <ol class="skill-list">
          {skills.filter((s) => s.group === group.id).map((s, i) => (
            <li class="reveal" style={`--d:${0.05 * i}s`}>
              <article class="skill-card">
                <div class="card-top">
                  <span class="mono-sm num">{String(i + 1).padStart(2, '0')}</span>
                  {s.status === 'wip' && <span class="chip wip mono-sm">打磨中</span>}
                  {s.date && <span class="mono-sm date">{s.date}</span>}
                </div>
                <h3>
                  {s.href ? (
                    <a href={s.href} target="_blank" rel="noopener">
                      {s.name} ↗
                    </a>
                  ) : (
                    s.name
                  )}
                </h3>
                <p>{s.description}</p>
                {s.tags && s.tags.length > 0 && (
                  <div class="tags">
                    {s.tags.map((t) => (
                      <span class="chip mono-sm">{t}</span>
                    ))}
                  </div>
                )}
              </article>
            </li>
          ))}
              </ol>
              </div>
              </div>
            </section>
          ))}
        </>
      ) : (
        <div class="empty-state reveal" style="--d:.15s">
          <div class="mono-label">COMING SOON</div>
          <p class="empty-title">第一批 Skill 正在打磨中。</p>
          <p class="empty-desc">
            日常工作里被反复验证过的做法，才值得固化成 Skill。
            近期会陆续把设计工程与 AI 工作流方向的几个技能包整理上架 ——
            在此之前，可以先去<a href="/blog/">博客</a>看看它们的由来。
          </p>
        </div>
      )
    }
  </div>
</Base>

<script>
  // Section 折叠:grid-template-rows 0fr↔1fr 的可中断 transition,caret 旋转指示
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.section-toggle')) {
    btn.addEventListener('click', () => {
      const block = btn.closest('.block');
      if (!block) return;
      const collapsed = block.classList.toggle('collapsed');
      btn.setAttribute('aria-expanded', String(!collapsed));
    });
  }
</script>

<style>
  /* 页头节奏与博客/组件页保持一致 */
  .skills-page {
    padding-top: clamp(112px, 15vw, 168px);
  }

  .page-head {
    margin-bottom: clamp(40px, 6vw, 64px);
  }

  .page-head .mono-label {
    display: block;
    margin-bottom: 22px;
  }

  .page-head h1 {
    margin-bottom: 22px;
  }

  .page-head .lead {
    max-width: 58ch;
  }

  .block + .block {
    margin-top: clamp(56px, 8vw, 88px);
  }

  /* ---- 可折叠 Section 头(button 化,复用 .section-head 视觉) ---- */
  .section-toggle {
    appearance: none;
    -webkit-appearance: none;
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--border);
    text-align: left;
    color: inherit;
    font: inherit;
    cursor: pointer;
    /* 头本身不再留下方间距,间距挪进可折叠区,折叠时一并收起 */
    margin-bottom: 0;
    transition: border-color 0.2s ease;
  }

  /* caret 是 <Fragment set:html> 注入的原始 svg,拿不到 Astro 作用域属性,故用 :global */
  .section-toggle :global(.toggle-caret) {
    margin-left: auto;
    align-self: center;
    color: var(--text-3);
    transition: transform 0.28s var(--ease-out), color 0.2s ease;
  }

  .section-toggle:hover :global(.toggle-caret) {
    color: var(--accent-strong);
  }

  /* 折叠态:caret 转到向上(默认向下 = 展开) */
  .block.collapsed :global(.toggle-caret) {
    transform: rotate(-180deg);
  }

  .collapse {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.34s var(--ease-out), opacity 0.26s ease;
  }

  /* 裁剪层:不带内边距,才能被 0fr 轨道压到 0 */
  .collapse-inner {
    min-height: 0;
    overflow: hidden;
  }

  /* 头与列表间距活在裁剪层内部,折叠时一并收起 */
  .collapse-inner > :global(ol) {
    padding-top: clamp(28px, 4vw, 44px);
  }

  .block.collapsed .collapse {
    grid-template-rows: 0fr;
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .collapse {
      transition: opacity 0.2s ease;
    }
  }

  .skill-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }

  .skill-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: clamp(20px, 3vw, 28px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    transition: border-color 0.2s ease, transform 0.3s var(--ease-out);
  }

  .skill-card:hover {
    border-color: var(--accent-border);
  }

  @media (hover: hover) and (pointer: fine) {
    .skill-card:hover {
      transform: translateY(-2px);
    }
  }

  .card-top {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text-mono);
  }

  .card-top .date {
    margin-left: auto;
  }

  .skill-card h3 {
    font-size: 19px;
    letter-spacing: -0.01em;
  }

  .skill-card h3 a {
    color: inherit;
  }

  .skill-card h3 a:hover {
    color: var(--accent-strong);
  }

  .skill-card p {
    color: var(--text-2);
    font-size: 14.5px;
    line-height: 1.7;
  }

  .tags {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding-top: 8px;
  }

  .chip.wip {
    color: var(--accent-strong);
    border-color: var(--accent-border);
  }

  .empty-state {
    max-width: 620px;
    padding: clamp(32px, 5vw, 48px);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .empty-title {
    margin-top: 14px;
    font-size: clamp(19px, 2.4vw, 22px);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .empty-desc {
    margin-top: 10px;
    color: var(--text-2);
    line-height: 1.8;
  }

  .empty-desc a {
    color: var(--accent-strong);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
