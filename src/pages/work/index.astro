---
import Base from '../../layouts/Base.astro';
import CaseList from '../../components/CaseList.astro';
---

<Base title="案例 - Aaron Xu" description="Aaron Xu 的全部作品案例：长文案例、实验与历史作品集。">
  <div class="work-page container">
    <header class="page-head">
      <div class="mono-label reveal">Work · All Cases</div>
      <h1 class="display reveal" style="--d:.05s">全部<span class="accent-text">案例</span>.</h1>
      <p class="lead reveal" style="--d:.1s">
        首页只放精选，这里是全部：长文案例、实验性探索，以及早年的历史作品集。
      </p>
    </header>

    <CaseList all />
  </div>
</Base>

<style>
  /* 页头节奏与 Skill/博客页保持一致 */
  .work-page {
    padding-top: clamp(112px, 15vw, 168px);
  }

  .page-head {
    margin-bottom: clamp(40px, 6vw, 64px);
  }

  .page-head .mono-label {
    display: block;
    margin-bottom: 22px;
  }

  .page-head h1 {
    margin-bottom: 22px;
  }

  .page-head .lead {
    max-width: 58ch;
  }
</style>
