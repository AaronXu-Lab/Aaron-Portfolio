---
import Layout from '../_Layout.astro';
import { BASE, products, type Product } from '../_data';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}
const { product } = Astro.props as { product: Product };
const related = products.filter((p) => p.slug !== product.slug).slice(0, 4);
---

<Layout title={product.name} description={product.summary}>
  <section class="section" style="padding-top: 40px">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={`${BASE}/products/`}>Products</a><span>/</span><span>{product.category}</span>
      </nav>
      <div class="detail">
        <div class="gallery">
          <div class="ph main"><img src={`/formyson/images/${product.slug}.jpg`} alt={product.name} loading="eager" decoding="async" /></div>
          <div class="thumbs">
            {["Top", "Center", "Fabric", "Silhouette"].map((t, i) => <div class={`ph thumb thumb-${i}`} style="--ar: 1 / 1"><img src={`/formyson/images/${product.slug}.jpg`} alt={`${product.name}, ${t.toLowerCase()} crop`} loading="lazy" decoding="async" /></div>)}
          </div>
        </div>
        <div class="info">
          <span class="eyebrow">{product.category}</span>
          <h1>{product.name}</h1>
          <p class="lead muted">{product.summary}</p>
          <div class="prose">
            <p>Built on our most-requested block, this style is cut and sewn in our Los Angeles facility. Every detail, from stitch density to rib recovery, is tuned by our in-house design team before bulk.</p>
            <ul>
              <li><strong>Custom options:</strong> fabric, color, fit and trims</li>
              <li><strong>Branding:</strong> woven labels, screen print, embroidery</li>
              <li>Fabric sourced from <a href="#">our certified mill partners</a></li>
            </ul>
          </div>
          <table class="specs">
            <tbody>
              {product.specs.map(([k, v]) => <tr><th>{k}</th><td>{v}</td></tr>)}
            </tbody>
          </table>
          <div class="actions">
            <a class="btn btn-dark" href={`${BASE}/contact/`}>Request a Quote</a>
            <a class="btn btn-ghost" href="#">Download Spec Sheet</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section wholesale">
    <div class="wrap wholesale-inner">
      <div>
        <h2>Contact us for wholesale inquiry</h2>
        <p class="muted">Private label, bulk orders and custom development.</p>
      </div>
      <a class="btn btn-dark" href={`${BASE}/contact/`}>Contact Us</a>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><div><h2>Related products</h2></div></div>
      <div class="grid grid-4">
        {related.map((p) => (
          <a class="card" href={`${BASE}/products/${p.slug}/`}>
            <div class="card-media"><div class="ph"><img src={`/formyson/images/${p.slug}.jpg`} alt={p.name} loading="lazy" decoding="async" /></div></div>
            <h3>{p.name}</h3>
            <p class="muted">{p.summary}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .detail { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(32px, 5vw, 80px); margin-top: 24px; align-items: start; }
  .gallery { display: grid; gap: 12px; }
  .thumb-0 img { object-position: center top; }
  .thumb-1 img { object-position: center center; }
  .thumb-2 img { object-position: 35% 65%; }
  .thumb-3 img { object-position: center bottom; }
  .thumbs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .info { display: grid; gap: 20px; position: sticky; top: 104px; }
  .info h1 { font-size: clamp(2rem, 4vw, 3rem); }
  .lead { font-size: 1.15rem; }
  .info .prose { font-size: 1rem; }
  .specs { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
  .specs th, .specs td { text-align: left; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .specs th { font-weight: 500; width: 40%; }
  .specs td { color: var(--muted); }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .wholesale { background: var(--surface); padding: 56px 0; }
  .wholesale-inner { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
  .wholesale h2 { font-size: 1.8rem; margin-bottom: 8px; }
  @media (max-width: 860px) {
    .detail { grid-template-columns: 1fr; }
    .info { position: static; }
  }
</style>
